{
  // Astro's strict settings cover the app (src/), the harness (spec/, scripts/)
  // and config files; `pnpm typecheck` runs `astro check` over all of them.
  // docs/ holds preserved exploration artefacts, not app code.
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "docs"]
}

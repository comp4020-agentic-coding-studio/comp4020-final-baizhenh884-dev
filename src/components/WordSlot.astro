---
// One position of the current sentence: its form (the HTTP contract at the
// top of spec/theseus.test.ts). Only what stands now: earlier words live in
// the earlier forms (?at=N) and, kept, in the kept strip. It names its part
// ("01 · Ram", drawn above the word, never read).
import { PARTS } from "../lib/ship/rules";

interface Props {
  position: number;
  version: number;
  word: string;
  marked: boolean;
}
const { position, version, word, marked } = Astro.props;
---

<div class="pos" data-part={PARTS[position][0].toUpperCase() + PARTS[position].slice(1)} style={`--tag: ${PARTS[position].length + 6}`}>
  <form method="post" action="/replace">
    <input type="hidden" name="position" value={position} />
    <input type="hidden" name="version" value={version} />
    <label for={`word-${position}`}>{marked ? <mark>{word}</mark> : word}</label>
    <input
      id={`word-${position}`}
      name="word"
      aria-describedby="how"
      placeholder={word}
      autocomplete="off"
      spellcheck="false"
      required
    />
  </form>
</div>

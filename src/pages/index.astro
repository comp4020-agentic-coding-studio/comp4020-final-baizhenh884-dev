---
import EarlierShip from "../components/EarlierShip.astro";
import WordSlot from "../components/WordSlot.astro";
import Page from "../layouts/Page.astro";
import { changeCount, completedShipAt, currentPositions, currentTrace, keptShipAt, logRows, sentenceAt, SETTLE_SECONDS } from "../lib/db";
import { isBlocked } from "../lib/blocklist";
import { logLine, logOf } from "../lib/log-record";
import { latestParts, replacedText, settleSecondsPhrase, standingLine, standingText } from "../lib/trace-text";
import { lastPlank } from "../lib/kept-sentence";
import { labelRows, sizeStep } from "../lib/sentence-step";
import { ensureVisitor } from "../lib/visitor";

const visitor = ensureVisitor(Astro.cookies, Astro.locals);

// GET /?at=N: the whole sentence after the first N changes, read-only.
// GET /: the current sentence, the only one that can be changed.
// Each has its harbour: the ships built in the browser from these same words,
// never stored, behind the sentence rather than instead of it.
// GET /?kept=k: completed kept ship k on its own (an earlier ship), or 404
const keptParam = Astro.url.searchParams.get("kept");
const lone = keptParam !== null && /^[1-9][0-9]{0,14}$/.test(keptParam) ? completedShipAt(Number(keptParam)) : null;
if (keptParam !== null && !lone) return new Response("Not found", { status: 404 });
const loneK = Number(keptParam);
const lonePrev = lone && loneK > 1 ? loneK - 1 : null;
const loneNext = lone && completedShipAt(loneK + 1) ? loneK + 1 : null;

const at = Astro.url.searchParams.get("at");
let earlier: string[] | null = null;
if (at !== null) {
  earlier = /^[0-9]{1,15}$/.test(at) ? sentenceAt(Number(at)) : null;
  if (!earlier) return new Response("Not found", { status: 404 });
}
const current = earlier ? [] : currentPositions();
const changes = changeCount();
const n = Number(at);
// which row each word's "01·Ram" stands in, per layout (a label wider than its word rises)
const rowsDesktop = labelRows(current.map((p) => p.word), "desktop"), rowsPhone = labelRows(current.map((p) => p.word), "phone");
const rowsAt = (i: number) => ({ desktop: rowsDesktop[i], phone: rowsPhone[i] });

// The second Theseus (docs/decisions/0003-settle-and-kept-ships.md): derived,
// never stored, and only for the live current sentence — an earlier form's
// kept ship isn't rendered (?at=N is a single read-only form of the sentence,
// not a live pairing). Always computed (cheap, one read), used only below.
const kept = keptShipAt();
// the most recent completed kept ship, the one way into the earlier ships (0: none yet)
const lastCompleted = earlier ? 0 : Math.min(...current.map((p) => p.version)) - 1;

// Which trace shape renders is itself rule-mode config, never guessed from
// the trace's own content (docs/decisions/0003-settle-and-kept-ships.md).
// Under `once` the markup below is unchanged, byte for byte, from Crit 9.
const trace = earlier ? null : currentTrace(visitor);
const markedPositions = new Set<number>(
  trace?.mode === "once" && trace.trace?.standing
    ? [trace.trace.position]
    : trace?.mode === "settle" && trace.trace
      ? [trace.trace.latest.standing ? trace.trace.latest.position : null, ...trace.trace.otherStanding.map((s) => s.position)].filter(
          (p): p is number => p !== null,
        )
      : [],
);
// your replaced words in the kept ship shown now: marked for you only (settle mode, plan B)
const keptMine = new Set<number>(
  trace?.mode === "settle" && trace.trace
    ? [
        ...(!trace.trace.latest.standing && trace.trace.latest.kept === "shown" ? [trace.trace.latest.position] : []),
        ...trace.trace.otherReplaced.filter((r) => r.kept === "shown").map((r) => r.position),
      ]
    : [],
);
// the log's record, on the current page only (decision 0006)
const log = earlier || lone ? [] : logOf(logRows(), isBlocked);
// the rule after the keys; "Press Escape to cancel." sits between them, in its own span (a phone has no Escape key)
const how =
  trace?.mode === "settle"
    ? "Anyone can change any word, yours too."
    : "You get one change, and it can't be undone. Anyone after you can change any word, including yours.";
---

<Page title="Theseus">
  {
    lone ? (
      <EarlierShip words={lone} prev={lonePrev} next={loneNext} />
    ) : earlier ? (
      <>
        <header class="mast">
          <h1 class="name">Theseus</h1><span class="sub caps">One sentence, two ships</span>
        </header>
        {/* an earlier form: its own ship alone on the water, built from its own words, never live */}
        <div id="harbour" class="harbour" data-scene="earlier" aria-hidden="true"></div>
        <div class="sentence-strip strip earlier-strip">
          <p class="form-state caps">An earlier form (read-only)</p>
          <p class="sentence past">
            {earlier.map((w, i) => (
              <>
                <span class="w">{w}</span>
                {i < earlier.length - 1 ? " " : "."}
              </>
            ))}
          </p>
          <nav class="history caps" aria-label="Earlier forms of the sentence">
            {n > 0 && <a rel="prev" href={`?at=${n - 1}`}>Earlier form</a>}
            {n + 1 < changes && <a rel="next" href={`?at=${n + 1}`}>Later form</a>}
            <a rel={n + 1 === changes ? "next" : undefined} href="/">Back to now</a>
          </nav>
        </div>
        <nav class="about caps" aria-label="site"><a href="/readme/">About Theseus</a> · <a href="/ship/">How the planks are made</a></nav>
        <script>
          import { mountEarlier } from "../lib/ship/page";

          mountEarlier(document);
        </script>
      </>
    ) : (
      <>
        {/* The question first: in full until this visitor has made a change (the server knows from their trace), then
            the question alone. Never live: it changes only on a fresh page, so another visitor's change never folds it. */}
        {/* the first screen: the question band, and the harbour with the sentence strip over its foot */}
        <div class="first">
        <section id="question" class:list={["sheet", { folded: !!trace?.trace }]} aria-labelledby="question-line">
          <div class="question-main">
            {/* the way to how the planks are made stands on the masthead's row: one link, kept when the band folds */}
            <header class="mast">
              <h1 class="name">Theseus</h1><span class="sub caps">One sentence, two ships</span>
              <a class="caps band-ship" href="/ship/">How the planks are made</a>
              {/* replays the opening story (decision 0007); shown only once the script that plays it has run */}
              <button id="story-open" class="caps band-story" type="button" hidden>The story</button>
            </header>
            <h2 id="question-line" class="question-line">If every plank is replaced, is it still the same ship?</h2>
            {!trace?.trace && (
              <p class="ship">Theseus’s ship had every plank replaced, one by one. Here the ship is built from a sentence of ten words, a plank for each, and each visitor replaces a piece at a time.</p>
            )}
          </div>
          {!trace?.trace && (
            <div class="how">
              <h3 class="caps">How to play</h3>
              <ol class="how-to-play">
                {/* each device's own gesture; the layout shows only the device's */}
                <li><span><span class="on-desktop">Click any word in the sentence.</span><span class="on-phone">Tap any word in the sentence.</span></span></li>
                <li><span>Type your own and press Enter. Its plank is rebuilt from how the word is spelled, not what it means.</span></li>
                <li><span>Replaced words are kept on the slipway: in the ship of old planks, or waiting for the next.</span></li>
              </ol>
            </div>
          )}
        </section>
        {/* the stage: the harbour (decorative), and over its foot the sentence strip */}
        <div class="stage">
          {/* one canvas: the live ship on the water, the kept ship on its slipway, the pallet; built in the browser */}
          <div id="harbour" class="harbour" data-scene="now" aria-hidden="true"></div>
          {/* each ship's tag for the part pointed at or chosen (a desktop; never at rest) */}
          <p class="part-tag caps" data-ship="live" aria-hidden="true" hidden></p>
          <p class="part-tag caps" data-ship="kept" aria-hidden="true" hidden></p>
          {/* the camera's controls on a desktop: zoom by buttons (the wheel scrolls the page), and the way back */}
          <div class="view-controls">
            <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
            <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
            <button id="home" class="caps" type="button" hidden>Back to the harbour</button>
          </div>
          <div id="sentence" class="sentence-strip strip">
            <div class="head-row">
              <p class="caps strip-label">Ten words · ten planks</p>
              <a class="caps to-kept" href="#kept">What was kept ↓</a>
            </div>
            <p class="sr-only" data-sentence-summary>The sentence now reads: {current.map((p) => p.word).join(" ")}.</p>
            {/* others' changes, said politely once a burst has settled (src/lib/live-client.ts); empty on load */}
            <p class="sr-only" id="news" aria-live="polite" aria-atomic="true"></p>
            {/* what the part notation predicts while a word is typed, said once typing pauses (the notation is aria-hidden) */}
            <p class="sr-only" id="foreseen" aria-live="polite" aria-atomic="true"></p>
            {/* your plank, said once when another visitor replaces your standing word (src/lib/ship/page.ts) */}
            <p class="sr-only" id="yours" aria-live="polite" aria-atomic="true"></p>
            {/* under settle, the hold's length, so a holding word can show how much of it is left (live-client) */}
            <div class="sentence" data-step={sizeStep(current.map((p) => p.word))} data-settle-ms={trace?.mode === "settle" ? SETTLE_SECONDS * 1000 : undefined}>
              {current.slice(0, -1).map((p) => (
                <>
                  <WordSlot position={p.position} version={p.version} word={p.word} marked={markedPositions.has(p.position)} rows={rowsAt(p.position)} />{" "}
                </>
              ))}
              {/* the full stop belongs to the sentence: it stays on the last word's line, never wraps alone */}
              {current.slice(-1).map((p) => (
                <span class="end"><WordSlot position={p.position} version={p.version} word={p.word} marked={markedPositions.has(p.position)} rows={rowsAt(p.position)} />.</span>
              ))}
            </div>
            <div class="slot">
              <p id="part" class="caps" aria-hidden="true" hidden></p>
              {/* at rest the notation's slot invites a change; choosing a word puts the notation there instead */}
              <div class="invite-row">
                <p class="invite caps" aria-hidden="true">Choose any word and type your own</p>
                <a class="caps invite-ship" href="/ship/">How the planks are made</a>
              </div>
            </div>
            {/* the kept strip is below on a phone: one quiet line says it's there */}
            <p class="kept-pointer">What was replaced is kept below.</p>
          </div>
          {/* the opening story (decision 0007): a first visit's five beats over the harbour; hidden until a script plays it */}
          <div id="story" class="story" role="dialog" aria-modal="false" aria-labelledby="story-title" hidden>
            <h2 id="story-title" class="sr-only">The story of the ship</h2>
            <div class="story-card">
              <div aria-live="polite" aria-atomic="true"><p data-story-line></p><cite class="caps" hidden></cite></div>
              <div class="story-controls">
                <button type="button" class="caps story-skip" data-story-skip>Skip</button>
                <button type="button" class="caps story-next" data-story-next>Next</button>
              </div>
            </div>
          </div>
        </div>
        </div>
        <div id="kept" class="kept-strip strip" data-original={kept.ship === 1 ? "true" : "false"}>
          <div class="head-row">
            <p class="caps strip-label kept-label">The ship of old planks</p>
            <a class="caps to-sentence" href="#sentence">Back to the sentence ↑</a>
          </div>
          {/* the kept sentence is read as words; a gap shows, faint, the word still standing there, read as "still standing:" then the word
              (src/lib/kept-sentence.ts redraws it the same way) */}
          <p class="kept-sentence">
            {kept.words.map((w, i) => {
              const word = kept.gaps[i] ? <><span class="sr-only">still standing: </span><span class="w gap">{w}</span></> : <span class="w">{keptMine.has(i) ? <mark>{w}</mark> : w}</span>;
              return i < kept.words.length - 1 ? <>{word}{" "}</> : <span class="end">{word}.</span>;
            })}
          </p>
          {/* what the kept sentence is (28 October playtest: it was read as a quiz, or as the original) */}
          <p class="kept-note">Replaced words, back in their places. Faint words still stand.</p>
          {/* the last plank (the maker, 30 October): one gap left, named; ship 1's planks are originals (src/lib/kept-sentence.ts) */}
          <p class="last-plank" hidden={lastPlank({ ...kept, original: kept.ship === 1 }) === null}>{lastPlank({ ...kept, original: kept.ship === 1 }) ?? ""}</p>
          {/* the next ship's words (decided 29 October): a replaced word that belongs to the next ship waits here,
              in place order with its place, read after the kept sentence; hidden when nothing waits
              (src/lib/kept-sentence.ts renderWaiting redraws it the same way) */}
          <p class="waiting" hidden={!kept.next.some((w) => w !== null)}><span class="label caps">Waiting for the next ship:</span> <span class="ws">{kept.next.flatMap((w, i) => (w === null ? [] : [<span class="w" data-n={String(i + 1).padStart(2, "0")}>{w}</span>, " "]))}</span></p>
          {/* not rel=prev: on GET / that is the Earlier form's, by the HTTP contract */}
          {lastCompleted > 0 && <p class="earlier caps"><a class="earlier-ship" href={`?kept=${lastCompleted}`}>Earlier ship</a></p>}
        </div>
        {/* your plank: the rule, in a sentence or two, and your trace (the HTTP contract's section with its role="status") */}
        <section id="your-plank" class="below" aria-labelledby="your-plank-heading">
          <h2 id="your-plank-heading" class="caps strip-label">Your plank</h2>
          <p id="how">Choose a word, type its replacement and press Enter. <span class="esc">Press Escape to cancel. </span>{how}</p>
            {trace?.mode === "once" && trace.trace && (
              <section aria-labelledby="trace-heading">
                <h3 id="trace-heading" class="sr-only">Your trace</h3>
                <p role="status">
                  {trace.trace.standing ? (
                    <>Your word “{trace.trace.word}” still stands, marked in the sentence above.</>
                  ) : (
                    <>
                      Your word “<del>{trace.trace.word}</del>” has since been replaced: “{trace.trace.now}” stands in its place now.
                    </>
                  )}
                </p>
              </section>
            )}
            {trace?.mode === "settle" && trace.trace && (
              <section aria-labelledby="trace-heading">
                <h3 id="trace-heading" class="sr-only">Your trace</h3>
                {(() => {
                  const parts = latestParts(trace.trace.latest, settleSecondsPhrase(SETTLE_SECONDS));
                  return (
                    <p role="status">
                      {parts.del ? (
                        <>
                          Your word “<del>{parts.del}</del>” has since been replaced: “{parts.now}” stands in its place now. {parts.kept} {parts.eligibility}
                        </>
                      ) : (
                        <>
                          {standingLine(parts)}
                        </>
                      )}
                    </p>
                  );
                })()}
                {trace.trace.otherStanding.length > 0 && (
                  <ul class="trace-standing">
                    {trace.trace.otherStanding.map((item) => <li>{standingText(item)}</li>)}
                  </ul>
                )}
                {trace.trace.otherReplaced.length > 0 && (
                  <ul class="trace-replaced">
                    {trace.trace.otherReplaced.map((item) => <li>{replacedText(item)}</li>)}
                  </ul>
                )}
              </section>
            )}
        </section>
        {/* the log (decision 0006): the ship's record, newest first, place and part, old word → new; nothing that says
            when or who; the latest 50, the blocklist applied here (src/lib/log-record.ts; the live page adds lines) */}
        <section id="log" class="below" aria-labelledby="log-heading" hidden={log.length === 0}>
          <h2 id="log-heading" class="caps strip-label">The log</h2>
          <ol class="log-lines">
            {log.map((line) => <li><span class="place">{logLine(line).place}</span> <span class="from">{line.from}</span> <span class="arrow">→</span> <span class="to">{line.to}</span></li>)}
          </ol>
        </section>
        {/* the page's foot: how the planks are made, the way back through the sentence's history, then the site's About */}
        <footer class="page-foot">
          <p class="foot-links caps"><a href="/ship/">How the planks are made</a>{changes > 0 && <><span class="sep-form"> · </span><a rel="prev" href={`?at=${changes - 1}`}>Earlier form</a></>}</p>
          <nav class="about caps" aria-label="site"><a href="/readme/">About Theseus</a></nav>
        </footer>
        <script>
          // Only the current sentence goes live; earlier forms never load this.
          import { attach, parseChange, parseSnapshot, type KeptShip, type Moment } from "../lib/live-client";
          import { classifyMoment } from "../lib/kept-moment";
          import { lastPlank, renderKeptSentence, waitingRow as waitingRowOf } from "../lib/kept-sentence";
          import { ACK_MS, acknowledgeBelow, LINE_MS, showMomentLine } from "../lib/moment-line";
          import { BEAT_MS } from "../lib/ship/kept-stage";
          import { duration, landsAt } from "../lib/ship/motion";
          import { mountHarbour } from "../lib/ship/page";
          import { mountStory } from "../lib/story-client";

          // The moment of a replacement (docs/decisions/0003, 0005): a plank that flies from the live ship to its gap
          // in the kept ship, or to the pallet for the next; ship 1's completion, announced once, live; a later
          // ship's quiet beat. Presentation only: what either ship settles on is the kept ship the server derived.
          const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
          const keptLabel = document.querySelector(".kept-sentence");
          const waitingRow = document.querySelector<HTMLElement>(".kept-strip .waiting");
          // the kept ship as GET / served it: the kept sentence's spans, a gap's word the live word standing there
          const keptSpans = [...document.querySelectorAll<HTMLElement>(".kept-sentence .w")];
          const liveWords = [...document.querySelectorAll<HTMLElement>('.sentence-strip .sentence form[action="/replace"] label')].map((l) => l.textContent!.trim());
          const next: (string | null)[] = Array(10).fill(null);
          for (const w of document.querySelectorAll<HTMLElement>(".kept-strip .waiting .ws .w")) next[Number(w.dataset.n) - 1] = w.textContent!.trim();
          const keptStrip = document.querySelector<HTMLElement>(".kept-strip");
          let keptNow: KeptShip = { words: keptSpans.map((s, i) => (s.classList.contains("gap") ? liveWords[i] : s.textContent!.trim())), gaps: keptSpans.map((s) => s.classList.contains("gap")), next, original: keptStrip?.dataset.original === "true" };
          const lastLine = document.querySelector<HTMLElement>(".kept-strip .last-plank");
          let pending: Moment | null = null; // the moment the next live change belongs to
          let beat = 0;
          // the waiting row as the kept ship says, except a word whose plank is still flying toward the pallet
          const waiting = waitingRow ? waitingRowOf(waitingRow, next) : null;
          const drawn = () => !!document.querySelector("#harbour canvas");

          // your own replaced words in the kept ship shown (settle mode): as the server marked them, then from your trace
          let mine = new Set<number>(keptSpans.flatMap((w, i) => (w.querySelector("mark") ? [i] : [])));
          function renderKept(k: KeptShip): void {
            if (keptLabel) renderKeptSentence(keptLabel, k, mine);
            waiting?.show(k.next);
            // the last plank follows the kept ship shown (a flag says whether it's ship 1, never its number)
            if (lastLine) { const line = lastPlank(k); lastLine.hidden = line === null; lastLine.textContent = line ?? ""; }
          }
          // When the shown ship gives way, its waiting words are the next ship's: they rise from the row into the
          // kept sentence, each to its own place, rather than reappearing from nowhere. Presentation only.
          function moveUp(from: (string | null)[]): void {
            if (reduced() || !waitingRow || !keptLabel) return;
            const at = new Map([...waitingRow.querySelectorAll<HTMLElement>(".ws .w")].map((w) => [Number(w.dataset.n) - 1, w.getBoundingClientRect()]));
            requestAnimationFrame(() => {
              const spans = [...keptLabel.querySelectorAll<HTMLElement>(".w")];
              from.forEach((w, i) => {
                const was = at.get(i), to = spans[i];
                if (w === null || !was || !to) return;
                const now = to.getBoundingClientRect();
                to.animate([{ transform: `translate(${was.left - now.left}px, ${was.top - now.top}px)`, opacity: 0.4 }, { transform: "none", opacity: 1 }], { duration: 900, easing: "cubic-bezier(.3,0,.2,1)" });
              });
            });
          }
          // Ship 1 complete: the one loud line, once, live, as the last plank sets down. Never on a load, a reconnect
          // or ?at=N. On a phone the pointer to the kept strip also says that a plank (or the whole first ship) was kept.
          function acknowledge(moment: Moment): void {
            const delay = reduced() ? 0 : 2400;
            if (moment.kind === "cross" || moment.kind === "first" || moment.kind === "wait") acknowledgeBelow(document, moment.kind, reduced(), moment.kind === "first" ? delay + LINE_MS + 1000 : ACK_MS);
            if (moment.kind === "first") setTimeout(() => showMomentLine(document, reduced()), delay);
          }
          // the kept sentence and waiting row for a kept ship and the moment a change brought to it (the harbour is told separately)
          function moveKept(k: KeptShip, moment: Moment | null): void {
            clearTimeout(beat);
            // a new change sets down whatever plank was still being carried, so its waiting word lands now
            if (moment) waiting?.finish();
            const before = keptNow;
            if (!moment) renderKept(k);
            else if (moment.kind === "later") {
              // the completed ship stands whole for its beat, in words as on the slipway; its waiting words still wait
              renderKept({ words: before.words, gaps: before.gaps.map(() => false), next: before.next });
              beat = window.setTimeout(() => { renderKept(k); moveUp(before.next); }, (reduced() ? 0 : duration("cross", false)) + BEAT_MS);
            } else if (before.gaps.every((g) => !g) && moment.kind === "cross") {
              // ship 1 was held whole: the first change after it starts ship 2, whose waiting words rise into it
              renderKept(k);
              moveUp(before.next);
            } else if (moment.kind === "wait") {
              // the word lands in the row when its plank is set down on the rack (only if a plank is carried)
              if (keptLabel) renderKeptSentence(keptLabel, k, mine);
              waiting?.land(k.next, drawn() ? landsAt(reduced()) : 0);
            } else renderKept(k);
            if (moment) acknowledge(moment);
            keptNow = k;
          }

          // This visitor's own change, just made (Post/Redirect/Get): the kept ship the page showed when they
          // submitted, read back once, if their word stands.
          let own: { position: number; moment: Moment; before: KeptShip } | null = null;
          try {
            const saved = sessionStorage.getItem("theseus:kept-before");
            sessionStorage.removeItem("theseus:kept-before");
            if (saved) {
              const { position, kept } = JSON.parse(saved) as { position: number; kept: KeptShip };
              const moment = document.querySelector(`label[for="word-${position}"] mark`) ? classifyMoment(kept, keptNow, position) : null;
              if (moment) own = { position, moment, before: kept };
            }
          } catch { /* no storage: no flight */ }
          for (const form of document.querySelectorAll<HTMLFormElement>('.sentence-strip .sentence form[action="/replace"]')) {
            form.addEventListener("submit", () => {
              const position = Number(form.querySelector<HTMLInputElement>('input[name="position"]')?.value);
              try { sessionStorage.setItem("theseus:kept-before", JSON.stringify({ position, kept: keptNow })); } catch { /* optional */ }
            });
          }
          // the page's own change: its words move as the plank does
          if (own) {
            const { moment, before } = own, now = keptNow;
            keptNow = before;
            moveKept(now, moment);
          }

          const harbour = mountHarbour(document, keptNow, (position) => (own && own.position === position ? { moment: own.moment, before: own.before } : null));
          harbour?.mine([...mine][0] ?? null);
          // the opening story, on a first visit (decision 0007): over the harbour if there is one, the same text if not
          mountStory(document, () => harbour);
          const page = attach(document, {
            onLatest: (change) => {
              // a plank flies for the moment this change brought (told just before, by onKept), else it's simply rebuilt
              const flight = pending && pending.position === change.position ? { moment: pending, kept: keptNow } : null;
              pending = null;
              harbour?.latest(change, flight);
            },
            onHeld: (position, word) => harbour?.held(position, word),
            onYours: (position) => harbour?.yours(position),
            onMine: (positions) => {
              mine = new Set(positions);
              harbour?.mine(positions[0] ?? null);
              renderKept(keptNow);
            },
            onKept: (k, moment) => {
              // a snapshot telling what the page already shows (every load's first one) changes nothing
              if (!moment && JSON.stringify(k) === JSON.stringify(keptNow)) return;
              pending = moment;
              moveKept(k, moment);
              if (!moment) harbour?.keptShow(k);
            },
          });
          const events = new EventSource("/events");
          events.addEventListener("snapshot", (e) => {
            const snapshot = parseSnapshot(e.data);
            if (snapshot) page.applySnapshot(snapshot);
          });
          events.addEventListener("change", (e) => {
            const change = parseChange(e.data);
            if (change) page.applyChange(change);
          });
          // the shipwrights (decision 0005): how many views are open, drawn as figures, never written as a number
          events.addEventListener("crew", (e) => {
            try {
              const { total } = JSON.parse(e.data) as { total: unknown };
              if (Number.isInteger(total)) harbour?.crew(total as number);
            } catch { /* a malformed event draws nothing */ }
          });
        </script>
      </>
    )
  }
</Page>

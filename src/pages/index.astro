---
import Page from "../layouts/Page.astro";
import { changeCount, currentPositions, recentPast, sentenceAt, traceFor } from "../lib/db";
import { ensureVisitor } from "../lib/visitor";

const visitor = ensureVisitor(Astro.cookies);

// GET /?at=N: the whole sentence after the first N changes, read-only.
// GET /: the current sentence, the only one that can be changed.
const at = Astro.url.searchParams.get("at");
let earlier: string[] | null = null;
if (at !== null) {
  earlier = /^[0-9]{1,15}$/.test(at) ? sentenceAt(Number(at)) : null;
  if (!earlier) return new Response("Not found", { status: 404 });
}
const current = earlier ? [] : currentPositions();
const past = earlier ? new Map<number, string[]>() : recentPast();
const changes = earlier ? 0 : changeCount();
const trace = earlier ? null : traceFor(visitor);
const yours = trace?.standing ? trace.position : null;
---

<Page title="Theseus">
  {
    earlier ? (
      <>
        <p>An earlier form of the sentence (read-only).</p>
        <p class="sentence">{earlier.join(" ")}.</p>
        <p><a href="/">Back to the sentence now</a></p>
      </>
    ) : (
      <>
        <p class="sr-only">The sentence now reads: {current.map((p) => p.word).join(" ")}.</p>
        <p id="how">
          Choose one word of the sentence and type a new one in its place. You get one change, and it can't be
          undone. Anyone after you can change any word, including yours.
        </p>
        <div class="sentence">
          {current.map((p, i) => (
            <>
              <div class="pos">
                <form method="post" action="/replace">
                  <input type="hidden" name="position" value={p.position} />
                  <input type="hidden" name="version" value={p.version} />
                  <label for={`word-${p.position}`}>{p.position === yours ? <mark>{p.word}</mark> : p.word}</label>
                  <input
                    id={`word-${p.position}`}
                    name="word"
                    aria-describedby="how"
                    placeholder={p.word}
                    autocomplete="off"
                    spellcheck="false"
                    required
                  />
                </form>
                {(past.get(p.position) ?? []).length > 0 && (
                  <span class="past" aria-hidden="true">
                    {(past.get(p.position) ?? []).map((w) => <span>{w}</span>)}
                  </span>
                )}
              </div>
              {i < current.length - 1 && " "}
            </>
          ))}.
        </div>
        {trace && (
          <section aria-labelledby="trace-heading">
            <h2 id="trace-heading">Your trace</h2>
            <p role="status">
              {trace.standing ? (
                <>Your word “{trace.word}” still stands, underlined in the sentence above.</>
              ) : (
                <>
                  Your word “<del>{trace.word}</del>” has since been replaced: “{trace.now}” stands in its place now.
                </>
              )}
            </p>
          </section>
        )}
        {changes > 0 && <p><a rel="prev" href={`?at=${changes - 1}`}>Earlier sentence</a></p>}
      </>
    )
  }
  <p><a href="/readme/">What this is</a></p>
</Page>

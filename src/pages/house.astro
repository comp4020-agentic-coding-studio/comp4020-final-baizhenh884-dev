---
// GET /house/: how the house reads a word. Every table and example is built
// from src/lib/house/ (the territories, their family order, the letter tests),
// so this can't drift from the rule. Read-only and never live: nothing to type
// into, because trying a word here would be the preview the house refuses.
// /readme/'s shell; its two tables share the width on a desktop
// (spec/house-page.test.ts).
import Page from "../layouts/Page.astro";
import { LETTERS, TESTS, type AdjectiveKey } from "../lib/house/features";
import { notation } from "../lib/house/notation";
import { describeTerritory, FAMILY_ORDER, TERRITORIES } from "../lib/house/territories";

const n = (p: number) => String(p + 1).padStart(2, "0");
const set = (s: Set<string>) => [...s].join(" ");
// the tests a family is decided by (FAMILY_ORDER), grouped by the feature each reads, with the letters it counts;
// a test no family uses (tall, long) decides nothing and isn't listed
const USED = new Set(Object.values(FAMILY_ORDER).flat().map((s) => s.test).filter((t): t is AdjectiveKey => t !== null));
const FEATURE_ROWS = ([
  { feature: "Length", tests: ["short", "long"] },
  { feature: "Vowels", letters: "vowels", tests: ["open"] },
  { feature: "Tall letters", letters: "tall", tests: ["tall", "veryTall", "flat"] },
  { feature: "Round letters", letters: "round", tests: ["round"] },
  { feature: "Hanging letters", letters: "hanging", tests: ["hangs"] },
  { feature: "Repeated letters", tests: ["repeats"] },
] as { feature: string; letters?: keyof typeof LETTERS; tests: AdjectiveKey[] }[])
  .map((row) => ({ ...row, tests: row.tests.filter((k) => USED.has(k)) }))
  .filter((row) => row.tests.length > 0);
// pairs checked to change their part's family (spec/house-page.test.ts)
const EXAMPLES: [number, string, string][] = [
  [4, "people", "cut"],
  [0, "Make", "jump"],
  [8, "it", "letterbox"],
  [2, "website", "hammock"],
];
---

<Page title="How the house reads a word">
  <div class="readme house-doc">
    <header class="mast">
      <span class="name">Theseus</span><span class="sub caps">How the house reads a word</span>
      <nav aria-label="site"><a class="caps" href="/">The sentence</a></nav>
    </header>
    <article>
      <p class="lede">Each of the ten places in the sentence always builds the same part of the house.</p>
      <p>
        The word written there decides only that part's form, and only through how it is written: its length and
        which letters it uses. Its meaning plays no part. Each part tries its families in order, and the first whose test
        the word passes is the one it gets.
      </p>
      <p>
        So the same word can make an arch at the entry and a plinth at the ground.
      </p>
    </article>

    <div class="tables">
      <section aria-labelledby="parts-heading" data-table="parts">
        <h2 id="parts-heading">Ten places, ten parts</h2>
        <table>
          <thead><tr><th scope="col"><span class="sr-only">Place</span></th><th scope="col">Part</th><th scope="col">Families, in the order they're tried</th></tr></thead>
          <tbody>
            {TERRITORIES.map((t, p) => (
              <tr data-part={t.id}>
                <td class="num">{n(p)}</td>
                <th scope="row" data-label>{t.label}</th>
                <td>
                  <ol class="order">
                    {FAMILY_ORDER[t.id].map((s) => (
                      <li data-family={s.family} data-test={s.test ?? ""}>
                        <span class="fam">{s.family}</span>
                        <span class="test">{s.test ? `if ${TESTS[s.test].yes}` : "otherwise"}</span>
                      </li>
                    ))}
                  </ol>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section aria-labelledby="letters-heading" data-table="letters">
        <h2 id="letters-heading">What the letters decide</h2>
        <table>
          <tbody>
            {FEATURE_ROWS.map((row) => (
              <tr>
                <th scope="row">
                  {row.feature}
                  {row.letters && <span class="letters" data-letters={row.letters}>{set(LETTERS[row.letters])}</span>}
                </th>
                <td>
                  <ul class="defs">
                    {row.tests.map((k) => (
                      <li data-test-def={k}><span class="fam">{TESTS[k].yes}</span>: {TESTS[k].means}</li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <p class="shapes" data-shapes>
          The letters also shape a part within its family: tall letters raise it, repeats multiply its windows, columns and bays,
          clusters of consonants thicken its walls. And a longer word reaches further, whatever its family.
        </p>

        <h2>Worked through</h2>
        <ul class="examples">
          {EXAMPLES.map(([p, was, word]) => (
            <li data-example data-position={p} data-was={was} data-word={word}>
              <span class="caps">{n(p)} — {TERRITORIES[p].label}</span>
              <span class="pair"><i>{was}</i> → <i>{word}</i></span>
              <span class="why">{notation({ position: p, word, was }).split(" · ").slice(1).join(" · ")}</span>
              <span class="sr-only">{`${was}: ${describeTerritory(p, was).family}; ${word}: ${describeTerritory(p, word).family}.`}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <p class="about caps"><a href="/">Back to the sentence</a> · <a href="/readme/">About Theseus</a></p>
  </div>
</Page>

<style is:global>
  /* /readme/'s shell, restated: readme.astro's own rules ship only with that page. Widened so the two
     tables share a desktop screen; the masthead and the intro keep its 36rem reading measure. */
  .house-doc { max-width: none; }
  .house-doc .mast { max-width: 36rem; margin-bottom: clamp(36px, 9vh, 88px); }
  .house-doc .mast nav { margin-left: auto; color: var(--soft); }
  .house-doc .mast nav a { text-decoration-color: var(--hair); }
  .house-doc article { max-width: 36rem; }
  .house-doc article > p { font: 400 clamp(20px, 1.55vw, 24px)/1.4 "Instrument Serif", serif; color: var(--ink); margin: 0 0 1.15em; }
  .house-doc article > p.lede { font-size: clamp(27px, 2.5vw, 38px); line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 1em; }

  .house-doc .tables { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 4.5vw, 88px); margin-top: clamp(48px, 9vh, 96px); padding-top: 1.1rem; border-top: 1px solid var(--hair); }
  .house-doc h2 { font: 400 0.7rem/1.5 "Instrument Sans", system-ui, sans-serif; letter-spacing: 0.17em; text-transform: uppercase; color: var(--soft); margin: 0 0 0.9rem; }
  .house-doc section h2:not(:first-child) { margin-top: 2.6rem; }
  .house-doc table { width: 100%; border-collapse: collapse; font: 400 0.92rem/1.5 "Instrument Sans", system-ui, sans-serif; color: var(--soft); }
  .house-doc thead th { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 400; text-align: left; padding: 0 0.8rem 0.5rem 0; }
  .house-doc tbody th, .house-doc tbody td { text-align: left; vertical-align: top; padding: 0.6rem 0.8rem 0.6rem 0; border-top: 1px solid var(--hair); font-weight: 400; }
  /* a part's name breaks only between its words, never inside one (main allows anywhere) */
  .house-doc tbody th { color: var(--ink); white-space: nowrap; overflow-wrap: normal; }
  .house-doc .num { width: 2.2rem; color: var(--soft); }
  .house-doc ol, .house-doc ul { list-style: none; margin: 0; padding: 0; }
  .house-doc .order { display: flex; flex-wrap: wrap; gap: 0.15rem 1.1rem; }
  .house-doc .fam { color: var(--ink); }
  .house-doc .test { margin-left: 0.3em; font-size: 0.86em; }
  .house-doc .letters { display: block; margin-top: 0.2rem; color: var(--soft); letter-spacing: 0.12em; font-size: 0.86em; white-space: nowrap; }
  .house-doc .defs li + li { margin-top: 0.25rem; }
  .house-doc .shapes { margin: 1.4rem 0 0; font: 400 0.92rem/1.55 "Instrument Sans", system-ui, sans-serif; color: var(--soft); max-width: 46ch; }
  .house-doc .examples li { display: grid; gap: 0.15rem; padding: 0.7rem 0; border-top: 1px solid var(--hair); font: 400 0.92rem/1.5 "Instrument Sans", system-ui, sans-serif; color: var(--soft); }
  .house-doc .examples .pair { color: var(--ink); font: italic 400 1.2rem/1.3 "Instrument Serif", serif; }
  .house-doc .examples .pair i { font-style: italic; }
  .house-doc > .about { margin-top: 3.4rem; }

  @media (max-width: 900px) {
    .house-doc .mast { margin-bottom: 2.4rem; }
    .house-doc .tables { grid-template-columns: minmax(0, 1fr); gap: 2.6rem; margin-top: 2.4rem; }
    .house-doc article > p.lede { font-size: 28px; }
    .house-doc article > p { font-size: 21px; }
    .house-doc tbody th { white-space: normal; }
  }
</style>

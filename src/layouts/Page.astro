---
// The one page shell: language, viewport, title and the minimal styles every
// view shares. Visitor words are only ever interpolated as text.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      body { margin: 0; font-family: Georgia, "Iowan Old Style", serif; line-height: 1.5; }
      main { max-width: 46rem; margin: 0 auto; padding: 2rem 1rem; overflow-wrap: anywhere; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .sentence { font-size: clamp(1.75rem, 6vw, 3rem); line-height: 1.2; margin: 1.5rem 0; }
      .sentence .pos { display: inline-flex; flex-direction: column; vertical-align: top; max-width: 100%; }
      .sentence form { display: inline; }
      .sentence label { cursor: text; }
      .sentence input[name="word"] { width: 0; padding: 0; border: 0; opacity: 0; font: inherit; font-size: 1rem; }
      .sentence form:focus-within input[name="word"] { width: min(12em, 80vw); opacity: 1; border-bottom: 2px solid; }
      .sentence form:focus-within label { outline: 3px solid; outline-offset: 2px; }
      .sentence .past { font-size: 0.9rem; opacity: 0.6; display: flex; flex-direction: column; }
      mark { background: none; text-decoration: underline 0.08em; text-underline-offset: 0.15em; }
      a:focus-visible, input:focus-visible { outline: 3px solid; outline-offset: 2px; }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>

---
// The one page shell: language, viewport, title and the styles every view
// shares, in Monograph: a light architectural-study field, the sentence set
// large in Instrument Serif, the house as its body beside it. Visitor words
// are only ever interpolated as text.
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      /* red has one job, a body being rebuilt now; nothing in these styles is red */
      :root { --field: #f1eee8; --ink: #191714; --soft: #6f685e; --faint: rgb(25 23 20 / 0.4); --hair: rgb(25 23 20 / 0.16); }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--field); color: var(--ink);
        font: 400 15px/1.45 "Instrument Sans", system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      }
      main { min-height: 100vh; padding: 4.2vh 5.2vw 4.6vh; overflow-wrap: anywhere; display: flex; flex-direction: column; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .caps { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
      a:hover { text-decoration-thickness: 2px; }
      a:focus-visible, input:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

      .mast { display: flex; align-items: baseline; gap: 1.1rem; border-bottom: 1px solid var(--hair); padding-bottom: 0.7rem; margin: 0 0 3vh; max-width: 46vw; }
      .mast .name { font: italic 400 1.55rem/1 "Instrument Serif", serif; }
      .mast .sub { color: var(--soft); }
      /* the sentence sits in the middle of the page's height, level with the house */
      .text { position: relative; z-index: 1; max-width: 46vw; margin: auto 0; padding: 2vh 0 4vh; }
      #how { margin: 0 0 1.5rem; color: var(--soft); max-width: 40ch; }

      /* the sentence: the protagonist, one column, set against the house like a plate and its caption */
      .sentence { font: 400 clamp(40px, 4.6vw, 86px)/1.04 "Instrument Serif", serif; letter-spacing: -0.012em; margin: 0 0 1.2rem; }
      .sentence.past { font-style: italic; color: #3b3630; }
      .sentence .pos { position: relative; display: inline-flex; flex-direction: column; vertical-align: top; max-width: 100%; padding-bottom: 0.18em; }
      /* Each word's label and input share one grid cell, so editing happens in
         the word's own place. The input contributes no width (width: 0) and
         fills the cell (min-width: 100%), so the cell is exactly the word:
         nothing shifts when it's focused. */
      .sentence form { position: relative; display: inline-grid; max-width: 100%; }
      .sentence form > label, .sentence form > input[name="word"] { grid-area: 1 / 1; min-width: 0; }
      .sentence input[name="word"] {
        width: 0; min-width: 100%; margin: 0; padding: 0; border: 0; border-bottom: 1px solid var(--ink); border-radius: 0;
        /* the label's own face, so the field is exactly the word's width and focusing it moves nothing */
        font: inherit; color: inherit; background: transparent; opacity: 0; cursor: text;
      }
      .sentence input[name="word"]::placeholder { color: var(--faint); opacity: 1; }
      .sentence form:focus-within label { visibility: hidden; }
      .sentence form:focus-within input[name="word"] { opacity: 1; outline: none; }
      /* the label carries the field's 1px rule, unseen, so the word and its field are the same size */
      .sentence label { border-bottom: 1px solid transparent; cursor: text; text-decoration-line: underline; text-decoration-thickness: 1px; text-decoration-color: transparent; text-underline-offset: 0.11em; transition: color 0.25s; }
      /* choosing a word: the others recede, the chosen one is drawn in ink */
      body.selecting .sentence .pos:not(.selected) label { color: var(--faint); }
      @media (hover: hover) {
        .sentence .pos:hover label:not(:has(mark)), .sentence .pos.pointed label:not(:has(mark)) { text-decoration-color: rgb(25 23 20 / 0.35); }
      }
      /* your word, while it stands: a hairline of dots, no badge */
      mark { background: none; color: inherit; text-decoration: underline dotted 1.5px var(--soft); text-underline-offset: 0.14em; }
      /* Where supported, grow with what's typed rather than scroll within the word,
         sideways only: one line high, so focusing a word doesn't move the sentence. */
      @supports (field-sizing: content) {
        .sentence form:focus-within input[name="word"] { field-sizing: content; width: auto; max-width: 80vw; height: calc(1lh + 1px); /* a line and its rule, as unfocused */ }
        /* until something is typed it lies over its word, which keeps its own width: focus moves nothing */
        .sentence form:focus-within input[name="word"]:placeholder-shown { position: absolute; left: 0; top: 0; }
      }
      /* The words a position held before sit beneath it but take no part in
         its width (width: 0, then min-width: 100% of the word), so the
         sentence spaces and wraps by its current words alone; a long one is
         cut short rather than pushing its neighbours apart. */
      .sentence .past {
        font: 400 0.8rem/1.3 "Instrument Sans", sans-serif; color: var(--soft); opacity: 0.75; display: flex; flex-direction: column;
        width: 0; min-width: 100%; margin-top: 0.35rem; letter-spacing: 0;
      }
      .sentence .past > span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; overflow-wrap: normal; }
      .sentence .past > span + span { opacity: 0.7; }
      /* the word leaving as its body is rebuilt (decorative; the label is the word) */
      .sentence .leaving { position: absolute; left: 0; top: 0; white-space: nowrap; pointer-events: none; }
      /* Someone else changed this word while you were typing a draft for it.
         The note keeps one line of height in its word's column (so it never
         covers the row below) but no width, so the sentence never re-flows;
         the client keeps it inside the sentence's width. */
      .sentence .changed {
        font: italic 400 1rem/1.3 "Instrument Serif", serif; color: var(--soft); margin-top: 0.35rem; letter-spacing: 0;
        width: 0; min-width: 100%; white-space: nowrap;
      }
      .sentence .changed > span {
        display: inline-block; vertical-align: top; position: relative; z-index: 1;
        padding-right: 0.4em; background: var(--field); overflow: hidden; text-overflow: ellipsis;
      }

      /* the part a word stands for, only while it's in hand */
      /* its line is always kept, so choosing a word never moves the centred column */
      #part { margin: 0 0 1rem; color: var(--soft); min-height: 1.45em; }
      #part[hidden] { display: block; visibility: hidden; }
      #house { position: fixed; top: 0; right: 0; width: 56vw; height: 100vh; z-index: 0; }
      #house canvas { display: block; width: 100%; height: 100%; }

      .history { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin: 1.5rem 0; }
      .history a, .earlier a, .about a { text-decoration-color: var(--hair); }
      .earlier, .about { margin: 1.2rem 0 0; color: var(--soft); }
      .form-state { color: var(--soft); margin: 0 0 1.2rem; }
      /* your trace: a quiet footnote to the shared sentence, not a panel */
      section[aria-labelledby="trace-heading"] { margin-top: 2rem; padding-top: 0.8rem; border-top: 1px solid var(--hair); max-width: 36ch; }
      #trace-heading { margin: 0 0 0.3rem; font-size: 0.66rem; font-weight: 400; letter-spacing: 0.18em; text-transform: uppercase; color: var(--soft); }
      section[aria-labelledby="trace-heading"] [role="status"] { margin: 0; font-size: 0.9rem; color: var(--soft); }
      section[aria-labelledby="trace-heading"] del { font: italic 400 1.1rem/1 "Instrument Serif", serif; color: var(--ink); text-decoration-thickness: 1px; }
      [role="alert"] { font: 400 1.6rem/1.25 "Instrument Serif", serif; max-width: 30ch; }

      @media (max-width: 900px) {
        main { padding: 1.1rem 1rem 1.4rem; }
        .mast, .text { max-width: none; }
        .text { margin: 0; padding: 0; }
        .mast { flex-wrap: wrap; gap: 0.2rem 0.9rem; margin-bottom: 1.1rem; }
        .sentence { font-size: 34px; line-height: 1.32; }
        /* a short word still gets a 44px target, widened evenly into the space around it */
        .sentence label { position: relative; }
        .sentence label::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: max(100%, 46px); transform: translateX(-50%); }
        .sentence form { min-height: 44px; }
        /* the house takes its own band under the sentence; the page scrolls through it as a page */
        #house { position: relative; width: auto; height: min(80vw, 420px); margin: 0.6rem -1rem 0; touch-action: pan-y; }
      }
      @media (prefers-reduced-motion: reduce) {
        .sentence label { transition: none; }
      }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>

---
// The one page shell: language, viewport, title and the styles every view
// shares, as a drawing sheet: the live half on drafting paper, the kept half a
// blueprint, each ruled with a faint grid; the sentence set large in
// Instrument Serif, every label lettered in IBM Plex Mono, the house as its
// body beside it. Visitor words are only ever interpolated as text.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";

interface Props {
  title: string;
  description?: string;
}
const DEFAULT_DESCRIPTION = "One shared sentence of ten words, and a house built from it. Anyone can replace a word, and its part of the house is rebuilt.";
const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
// absolute, from the request itself, so a shared link is right wherever the app runs
const url = new URL(Astro.url.pathname + Astro.url.search, Astro.url.origin).href;
const image = new URL("/og.png", Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:global>
      /* red has one job, a body being rebuilt now; nothing in these styles is red */
      :root {
        /* drafting paper and blueprint; labels and captions are legible on a grid line, not just the flat ground (spec/two-ships-layout.test.ts) */
        --field: #ece8df; --ink: #191714; --soft: #5a544b; --caption: #3f3a33; --faint: rgb(25 23 20 / 0.4); --hair: rgb(25 23 20 / 0.16);
        --kept-ground: #1d3350; --kept-ink: #eef3f8; --kept-soft: #9fb1c7; --kept-caption: #b9c7d8; --kept-gap: #dce6f2;
        --grid: rgb(25 23 20 / 0.045); --kept-grid: rgb(255 255 255 / 0.055); --frame: rgb(25 23 20 / 0.22); --kept-frame: rgb(255 255 255 / 0.22);
        --rule: rgb(25 23 20 / 0.3); --kept-rule: rgb(255 255 255 / 0.28);
        --mono: "IBM Plex Mono", ui-monospace, monospace;
      }
      /* a sheet: a faint grid, ruled both ways, on its own ground */
      .sheet { background-color: var(--field); background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 24px 24px; }
      .blueprint { background-color: var(--kept-ground); background-image: linear-gradient(var(--kept-grid) 1px, transparent 1px), linear-gradient(90deg, var(--kept-grid) 1px, transparent 1px); background-size: 24px 24px; }
      * { box-sizing: border-box; }
      body {
        margin: 0; color: var(--ink);
        background-color: var(--field); background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 24px 24px;
        font: 400 15px/1.45 "Instrument Sans", system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      }
      main { min-height: 100vh; padding: 4.2vh 5.2vw 4.6vh; overflow-wrap: anywhere; display: flex; flex-direction: column; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .caps { font: 500 0.69rem/1.35 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
      a:hover { text-decoration-thickness: 2px; }
      a:focus-visible, input:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

      .mast { display: flex; align-items: baseline; gap: 1.1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.7rem; margin: 0 0 3vh; max-width: 46vw; }
      .mast .name { font: italic 400 1.55rem/1 "Instrument Serif", serif; margin: 0; }
      .mast .sub { color: var(--soft); }
      /* the sentence sits in the middle of the page's height, level with the house */
      .text { position: relative; z-index: 1; max-width: 46vw; margin: auto 0; padding: 2vh 0 4vh; }
      /* the current sentence is read first, with its rules beneath it */
      .text.current { display: flex; flex-direction: column; }
      /* the captions are read, not glanced at: 15px (14px on a phone), in --caption, 6.5:1 on the field */
      #how { margin: 1.3rem 0 0; font-size: 15px; line-height: 1.5; color: var(--caption); max-width: 52ch; }

      /* the sentence: the protagonist, one column, set against the house like a plate and its caption */
      .sentence { font: 400 clamp(40px, 4.6vw, 86px)/1.04 "Instrument Serif", serif; letter-spacing: -0.012em; margin: 0 0 1.2rem; }
      .sentence.past { font-style: italic; color: #3b3630; }
      /* the last word and the full stop: no line break between them, while the word itself wraps as any other */
      .sentence .end { white-space: nowrap; }
      .sentence .end > .pos { white-space: normal; }
      .sentence .pos { position: relative; display: inline-flex; flex-direction: column; vertical-align: top; max-width: 100%; padding-bottom: 0.18em; }
      /* Each word's label and input share one grid cell, so editing happens in
         the word's own place. The input contributes no width (width: 0) and
         fills the cell (min-width: 100%), so the cell is exactly the word:
         nothing shifts when it's focused. */
      .sentence form { position: relative; display: inline-grid; max-width: 100%; }
      .sentence form > label, .sentence form > input[name="word"] { grid-area: 1 / 1; min-width: 0; }
      .sentence input[name="word"] {
        width: 0; min-width: 100%; margin: 0; padding: 0; border: 0; border-bottom: 1px solid var(--ink); border-radius: 0;
        /* the label's own face, so the field is exactly the word's width and focusing it moves nothing */
        font: inherit; letter-spacing: inherit; color: inherit; background: transparent; opacity: 0; cursor: text;
      }
      .sentence input[name="word"]::placeholder { color: var(--faint); opacity: 1; }
      .sentence form:focus-within label { visibility: hidden; }
      /* shown while in hand, with the page's keyboard focus outline (a:focus-visible, input:focus-visible) */
      .sentence form:focus-within input[name="word"] { opacity: 1; }
      /* the label carries the field's 1px rule, unseen, so the word and its field are the same size */
      .sentence label { border-bottom: 1px solid transparent; cursor: text; text-decoration-line: underline; text-decoration-thickness: 1px; text-decoration-color: transparent; text-underline-offset: 0.11em; transition: color 0.25s; }
      /* choosing a word: the others recede, the chosen one is drawn in ink */
      body.selecting .sentence .pos:not(.selected) label { color: var(--faint); }
      @media (hover: hover) {
        .sentence .pos:hover label:not(:has(mark)), .sentence .pos.pointed label:not(:has(mark)) { text-decoration-color: rgb(25 23 20 / 0.35); }
      }
      /* a touch screen: every word at rest shows it can be changed, by a faint solid line (your own word keeps its dotted one).
         Coarse as well as no hover: a headless desktop with no pointer at all matches (hover: none) too */
      @media (hover: none) and (pointer: coarse) {
        .sentence label:not(:has(mark)) { text-decoration-color: var(--hair); }
      }
      /* your holding word: a thin line fills under it until the hold ends (settle mode, your page only); never red */
      .sentence .settling {
        position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; pointer-events: none;
        background: var(--soft); transform-origin: left; transform: scaleX(var(--from, 0));
        animation: settling var(--ms, 0ms) linear forwards;
      }
      @keyframes settling { to { transform: scaleX(1); } }
      /* your word, while it stands: a hairline of dots, no badge */
      mark { background: none; color: inherit; text-decoration: underline dotted 1.5px var(--soft); text-underline-offset: 0.14em; }
      /* Where supported, grow with what's typed rather than scroll within the word,
         sideways only: one line high, so focusing a word doesn't move the sentence. */
      @supports (field-sizing: content) {
        .sentence form:focus-within input[name="word"] { field-sizing: content; width: auto; max-width: 80vw; height: calc(1lh + 1px); /* a line and its rule, as unfocused */ }
        /* until something is typed it lies over its word, which keeps its own width: focus moves nothing */
        .sentence form:focus-within input[name="word"]:placeholder-shown { position: absolute; left: 0; top: 0; }
      }
      /* Without field-sizing the grid cell is all the field gets, and the rule above that
         should widen it (min-width: 100%) loses to the shared `min-width: 0` on specificity,
         so the focused field was 0px wide: focused, taking keystrokes, and invisible, with
         its word hidden. Here it lies over its word instead: the word's own box (the cell
         keeps its size, so nothing moves), wider when it needs to be, over what's beside it. */
      @supports not (field-sizing: content) {
        .sentence form:focus-within input[name="word"] { position: absolute; left: 0; top: 0; height: 100%; width: max(100%, 3.2em); max-width: 80vw; background: var(--field); z-index: 1; }
      }
      /* the word leaving as its body is rebuilt (decorative; the label is the word) */
      .sentence .leaving { position: absolute; left: 0; top: 0; white-space: nowrap; pointer-events: none; }
      /* Someone else changed this word while you were typing a draft for it.
         The note keeps one line of height in its word's column (so it never
         covers the row below) but no width, so the sentence never re-flows;
         the client keeps it inside the sentence's width. */
      .sentence .changed {
        font: italic 400 1rem/1.3 "Instrument Serif", serif; color: var(--soft); margin-top: 0.35rem; letter-spacing: 0;
        width: 0; min-width: 100%; white-space: nowrap;
      }
      .sentence .changed > span {
        display: inline-block; vertical-align: top; position: relative; z-index: 1;
        padding-right: 0.4em; background: var(--field); overflow: hidden; text-overflow: ellipsis;
      }

      /* the part a word stands for, only while it's in hand */
      /* its line is always kept, so choosing a word never moves the centred column */
      #part { margin: 0 0 1rem; color: var(--soft); min-height: 1.45em; }
      #part[hidden] { display: block; visibility: hidden; }
      /* An earlier form: one house, beside its sentence. */
      main > #house { position: fixed; top: 0; right: 0; width: 56vw; height: 100vh; z-index: 0; }
      #house canvas, #house-kept canvas { display: block; width: 100%; height: 100%; }

      /* Two ships (docs/decisions/0003-settle-and-kept-ships.md), two equal halves:
         what stands on the study field, what was kept on dark umber. Each half's
         rows (heading, sentence, house, foot) are shared, so the two houses stand
         level across the gutter. */
      main:has(> .two) { padding: 0; }
      /* the house row takes at least half the screen; the notes under it may fall below the first screen */
      .two { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto minmax(50vh, 1fr) auto; min-height: 100vh; }
      .half { grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; min-width: 0; padding: 3.4vh 3.6vw 3.6vh; }
      .stands-half, .kept-half { position: relative; }
      .kept-half { color: var(--kept-ink); }
      /* each sheet's inset hairline frame (decorative) */
      .half::before { content: ""; position: absolute; inset: 18px; border: 1px solid var(--frame); pointer-events: none; z-index: 0; }
      .kept-half::before { border-color: var(--kept-frame); }
      .half-head { display: flex; flex-direction: column; justify-content: end; }
      .half-label { margin: 0 0 1.6vh; color: var(--soft); }
      .kept-half .half-label { color: var(--kept-soft); }
      /* a half's label row; on a phone it also names and links to the other half (hidden side by side) */
      .head-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
      .to-kept, .to-stands { display: none; white-space: nowrap; color: var(--soft); text-decoration-color: var(--hair); }
      .to-stands { color: var(--kept-soft); text-decoration-color: rgb(159 177 199 / 0.45); }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      .stands-half .mast, .stands-half .text { max-width: none; }
      .stands-half .mast { margin-bottom: 2.4vh; }
      /* the live sentence, set to its half: still the largest thing on the page */
      /* side by side, a long sentence steps down through fixed sizes to stay on two lines (src/lib/sentence-step.ts) */
      .two .sentence { --step: 1; font-size: calc(clamp(36px, 3.8vw, 72px) * var(--step)); }
      .two .sentence[data-step="1"] { --step: 0.92; }
      .two .sentence[data-step="2"] { --step: 0.85; }
      .two .sentence[data-step="3"] { --step: 0.8; }
      .stands-half .text { margin: 0; padding: 0; }
      /* the part notation lies over the house's own empty top band, which no house at rest reaches
         (spec/two-ships-layout.test.ts), so no line is held between the sentence and its house */
      .stands-half #part, .stands-half .invite { position: absolute; top: calc(100% - 0.5rem); left: 0; right: 0; margin: 0; }
      .stands-half .invite { color: var(--caption); white-space: nowrap; }
      .stands-half #part:not([hidden]) ~ .invite { visibility: hidden; }
      /* while a replacement is typed: one line, the replaced word struck, and only it shortened when long; the keys are never cut */
      #part:has(> del) { display: flex; white-space: pre; }
      #part > span { flex: none; }
      #part > del { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; text-decoration-thickness: 1px; }
      /* the row decides a house's size, never its canvas: the canvas lies over its host */
      #house, #house-kept { position: relative; min-height: 0; margin: 0 -3.6vw; overflow: hidden; }
      .half #house canvas, .half #house-kept canvas { position: absolute; inset: 0; }
      /* the kept sentence: a sentence in its own right, a step below the live one, which stays primary */
      .kept-sentence { font: italic 400 clamp(28px, 2.85vw, 54px)/1.16 "Instrument Serif", serif; letter-spacing: -0.01em; margin: 0 0 1.2rem; color: var(--kept-ink); }
      .kept-sentence .end { white-space: nowrap; }
      /* your own kept word, for you only: the same dotted hairline as in the live sentence, in the kept half's own ink */
      .kept-sentence mark { text-decoration-color: var(--kept-soft); }
      /* a gap: a blank in the sentence, waiting for the word that stands there now */
      .kept-sentence .gap { display: inline-block; width: 1.8em; height: 0.7em; border-bottom: 2px solid var(--kept-gap); }
      .foot { display: flex; flex-direction: column; gap: 0.9rem; padding-top: 1rem; }
      .kept-half .plate-note { color: var(--kept-ink); }
      /* what the kept sentence's words and gaps are: a quiet key under the caption */
      .kept-half .kept-key { margin: 0; font-size: 15px; line-height: 1.5; color: var(--kept-caption); max-width: 40ch; }
      .kept-half .earlier { color: var(--kept-soft); }
      .kept-half .earlier a { text-decoration-color: rgb(159 177 199 / 0.45); }
      /* the live half's notes sit in its foot, under its house, so a long trace never pushes the house away */
      .foot #how { margin: 0; }
      .foot section[aria-labelledby="trace-heading"] { margin-top: 0.4rem; }
      .foot .earlier { margin: 0; }
      /* only when the halves stack: the kept half is far below, so say so */
      .kept-pointer { display: none; margin: 0; font: italic 400 1.05rem/1.3 "Instrument Serif", serif; color: var(--soft); }

      /* an earlier house (/?kept=k): the kept ship alone on its own ground, read-only */
      main:has(> .lone-house) { background-color: var(--kept-ground); background-image: linear-gradient(var(--kept-grid) 1px, transparent 1px), linear-gradient(90deg, var(--kept-grid) 1px, transparent 1px); background-size: 24px 24px; color: var(--kept-ink); }
      .lone-house { display: flex; flex-direction: column; min-height: calc(100vh - 8.8vh); color: var(--kept-ink); }
      .lone-house .mast { border-bottom-color: var(--kept-rule); max-width: none; }
      .lone-house .mast .sub, .lone-house .half-label, .lone-house .history, .lone-house .about { color: var(--kept-soft); }
      .lone-house .kept-sentence { max-width: 30ch; }
      .lone-house #house-kept { position: relative; flex: 1; min-height: 48vh; }
      .lone-house #house-kept canvas { position: absolute; inset: 0; }
      .lone-house .history a, .lone-house .about a { text-decoration-color: rgb(159 177 199 / 0.45); }
      .history { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin: 1.5rem 0; }
      .history a, .earlier a, .about a { text-decoration-color: var(--hair); }
      .earlier, .about { margin: 1.2rem 0 0; color: var(--soft); }
      .form-state { color: var(--soft); margin: 0 0 1.2rem; }
      /* your trace: a quiet footnote to the shared sentence, not a panel */
      section[aria-labelledby="trace-heading"] { margin-top: 2rem; padding-top: 0.8rem; border-top: 1px solid var(--hair); max-width: 42ch; }
      #trace-heading { margin: 0 0 0.3rem; font-size: 0.66rem; font-weight: 400; letter-spacing: 0.18em; text-transform: uppercase; color: var(--soft); }
      section[aria-labelledby="trace-heading"] [role="status"] { margin: 0; font-size: 15px; line-height: 1.5; color: var(--caption); }
      section[aria-labelledby="trace-heading"] del { font: italic 400 1.1rem/1 "Instrument Serif", serif; color: var(--ink); text-decoration-thickness: 1px; }
      section[aria-labelledby="trace-heading"] ul { list-style: none; margin: 0.6rem 0 0; padding: 0; font-size: 0.85rem; color: var(--soft); }
      section[aria-labelledby="trace-heading"] ul + ul { margin-top: 0.3rem; }
      section[aria-labelledby="trace-heading"] li { margin: 0.25rem 0; }
      [role="alert"] { font: 400 1.6rem/1.25 "Instrument Serif", serif; max-width: 30ch; }

      /* ---- word and territory as one selection ---- */
      /* pointing at a word, the house or your trace: the other words step back, as when one is chosen */
      body.pointing .sentence .pos:not(.pointed) label { color: var(--faint); }
      @media (hover: hover) {
        .sentence .pos.pointed label:not(:has(mark)) { text-decoration-color: rgb(25 23 20 / 0.7); }
      }
      /* the one hairline from the chosen word to its territory; red is only the rebuilding of that territory */
      .thread { display: block; position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 0.18s; }
      .thread.on { opacity: 1; }
      .thread path { fill: none; stroke: var(--ink); stroke-opacity: 0.5; stroke-width: 1; vector-effect: non-scaling-stroke; }
      .thread circle { fill: var(--ink); fill-opacity: 0.7; }
      .thread.red path { stroke: #c3331c; stroke-opacity: 0.85; }
      .thread.red circle { fill: #c3331c; fill-opacity: 0.9; }

      /* the plate's caption, under the house; and the question, at the foot beside About */
      .plate-note { font: italic 400 clamp(20px, 1.7vw, 28px)/1.22 "Instrument Serif", serif; color: var(--ink); margin: 0; letter-spacing: -0.005em; text-wrap: balance; }
      .plate-note .line { display: block; text-wrap: balance; }
      .question { font: italic 400 clamp(15px, 1.15vw, 19px)/1.35 "Instrument Serif", serif; color: var(--soft); margin: 0; max-width: 34ch; }
      /* the captions end on more than one word (spec/two-ships-layout.test.ts) */
      #how, section[aria-labelledby="trace-heading"] [role="status"], .kept-key, .question { text-wrap: pretty; }
      .foot .about { margin: 0; }
      /* each link reads as one unit, never broken inside itself */
      .about a { white-space: nowrap; }
      /* Side by side, the live half's notes fold into two columns, each its own stack: the rule, your trace
         and the links on the left, the captions on the right. The foot gets shorter, so the house's row,
         which takes what's left, gets taller (spec/two-ships-layout.test.ts). Stacked (a phone), the two
         columns dissolve and the notes read in one column, the links last.
         Side by side, the links take a row of their own across both columns, so "How the house reads a
         word" never breaks in the narrow left one; placed here, still last in the markup. */
      .foot-main, .foot-aside { display: flex; flex-direction: column; gap: 0.9rem; min-width: 0; }
      @media (min-width: 901px) {
        /* rows: the rule, your trace, Earlier, a spacer the captions grow into, the links */
        .stands-half .foot { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); grid-template-rows: auto auto auto 1fr auto; column-gap: 3vw; row-gap: 0; align-items: start; }
        .stands-half .foot-main { display: contents; }
        .stands-half .foot-main > * { grid-column: 1; }
        .stands-half .foot #how { grid-row: 1; }
        .stands-half .foot section[aria-labelledby="trace-heading"] { grid-row: 2; margin-top: 1.3rem; }
        .stands-half .foot .earlier { grid-row: 3; margin-top: 0.9rem; }
        .stands-half .foot-aside { grid-column: 2; grid-row: 1 / 5; }
        .stands-half .foot .about { grid-column: 1 / -1; grid-row: 5; margin-top: 1.1rem; }
        /* a drawing's title block: the foot ruled off from the sheet, its columns divided by a hairline,
           the question under a rule of its own (decorative: the rules are borders, the reading order is the markup's) */
        .half > .foot { margin: 0 -1.6vw; padding: 1rem 1.6vw 0.4rem; border-top: 1px solid var(--rule); }
        .kept-half > .foot { border-top-color: var(--kept-rule); }
        .stands-half .foot { column-gap: 0; }
        .stands-half .foot-main > * { padding-right: 1.6vw; }
        .stands-half .foot-aside { border-left: 1px solid var(--rule); padding-left: 1.6vw; }
        .stands-half .foot .question { border-top: 1px solid var(--rule); padding-top: 0.8rem; }
        .stands-half .foot .about { padding-top: 0.8rem; border-top: 1px solid var(--rule); margin-top: 1rem; }
      }
      @media (max-width: 900px) {
        .foot-main, .foot-aside { display: contents; }
        .foot .about { order: 1; }
      }

      /* Ship 1 complete (docs/decisions/0003): the one loud line, live, once, across both
         halves. Not red (red is only a part being rebuilt): pale, in difference, so it reads
         as ink on the study field and as light on the kept ground. src/lib/moment-line.ts
         sets its top in the clear band of the screen; both halves are veiled behind it. */
      .moment {
        position: fixed; left: 0; right: 0; top: 38%; z-index: 4; margin: 0; padding: 0 6vw; text-align: center; pointer-events: none;
        font: italic 400 clamp(34px, 5.4vw, 104px)/1.02 "Instrument Serif", serif; letter-spacing: -0.015em; text-wrap: balance;
        color: #fff; mix-blend-mode: difference; opacity: 0; transition: opacity 0.7s;
      }
      .moment.on { opacity: 1; }
      /* the veil: each half recedes into its own ground behind the line, and comes back when it goes */
      .half { position: relative; }
      .half::after { content: ""; position: absolute; inset: 0; z-index: 3; background: inherit; opacity: 0; pointer-events: none; transition: opacity 0.6s; }
      body.moment-on .half::after { opacity: 0.86; }
      /* the phone pointer, acknowledging a part just kept below: ink rather than grey, never red */
      .kept-pointer.ack { color: var(--ink); position: relative; z-index: 4; /* above the veil, so it reads while the line is up */ }

      @media (max-width: 900px) {
        /* on a phone the house sits under the sentence, and a line between them would cut through the text: selection alone carries it */
        .thread { display: none; }
        main { padding: 1.1rem 1rem 1.4rem; }
        .mast, .text { max-width: none; }
        .text { margin: 0; padding: 0; }
        .mast { flex-wrap: wrap; gap: 0.2rem 0.9rem; margin-bottom: 1.1rem; }
        .sentence { font-size: 34px; line-height: 1.32; }
        #how, section[aria-labelledby="trace-heading"] [role="status"], .kept-half .kept-key { font-size: 14px; }
        /* no Escape key on a phone: the instructions' Escape sentence is read, not shown */
        #how .esc { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        /* the words sit ~5px apart here: the focus outline hugs its word so it never touches the one beside or below */
        .sentence input[name="word"]:focus-visible { outline-offset: 1px; }
        /* a word's target is as tall as its form (44px) and a little wider than the word, into the
           space beside it and no further: two short words side by side ("if it") used to have 46px
           targets that overlapped, and a tap on the first went to the second */
        .sentence label { position: relative; }
        .sentence label::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: calc(100% + 0.16em); transform: translateX(-50%); }
        .sentence form { min-height: 44px; }
        /* the two halves stack: what stands, then what was kept, each a band of its own ground */
        .two { display: block; min-height: 0; }
        .kept-pointer { display: block; }
        .half { display: flex; flex-direction: column; padding: 1.1rem 1rem 1.6rem; }
        /* the frame sits in the gutter, outside the text, never through it */
        .half::before { inset: 6px; }
        .half-label { margin-bottom: 0.8rem; }
        .to-kept, .to-stands { display: inline; }
        main > #house { position: relative; width: auto; height: min(80vw, 420px); margin: 0.6rem -1rem 0; touch-action: pan-y; }
        #house { height: min(80vw, 420px); margin: 0 -1rem; touch-action: pan-y; }
        #house-kept { height: min(80vw, 420px); margin: 0 -1rem; touch-action: pan-y; }
        .two .sentence { font-size: 34px; }
        .kept-sentence { font-size: 26px; line-height: 1.3; }
      }
      @media (prefers-reduced-motion: reduce) {
        .sentence label { transition: none; }
        .thread { transition: none; }
        .moment, .half::after { transition: none; }
      }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>

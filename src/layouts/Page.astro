---
// The one page shell: language, viewport, title and the styles every view
// shares: the question on drafting paper, the harbour's sunlit scene, and the
// sentence and the kept sentence on parchment strips (docs/decisions/0005);
// the sentences set in Instrument Serif, every label lettered in IBM Plex
// Mono. Visitor words are only ever interpolated as text.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";

interface Props {
  title: string;
  description?: string;
}
const DEFAULT_DESCRIPTION = "One shared sentence of ten words, and a ship built from it, a plank for each. Anyone can replace a word, and its plank is rebuilt; the old planks are kept.";
const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
// absolute, from the request itself, so a shared link is right wherever the app runs
const url = new URL(Astro.url.pathname + Astro.url.search, Astro.url.origin).href;
const image = new URL("/og.png", Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:global>
      /* red has one job, a body being rebuilt now; nothing in these styles is red */
      :root {
        /* drafting paper for the band and the notes; labels and captions are legible on a grid line, not just the flat ground */
        --field: #ece8df; --ink: #191714; --soft: #5a544b; --caption: #3f3a33; --faint: rgb(25 23 20 / 0.4); --hair: rgb(25 23 20 / 0.16);
        --kept-ground: #1d3350; --kept-ink: #eef3f8; --kept-soft: #9fb1c7; --kept-caption: #b9c7d8; --kept-gap: #dce6f2; --kept-faint: var(--kept-soft);
        --grid: rgb(25 23 20 / 0.045); --kept-grid: rgb(255 255 255 / 0.055); --frame: rgb(25 23 20 / 0.22); --kept-frame: rgb(255 255 255 / 0.22);
        --rule: rgb(25 23 20 / 0.3); --kept-rule: rgb(255 255 255 / 0.28);
        --mono: "IBM Plex Mono", ui-monospace, monospace;
      }
      /* a sheet: a faint grid, ruled both ways, on its own ground */
      .sheet { background-color: var(--field); background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 24px 24px; }
      .blueprint { background-color: var(--kept-ground); background-image: linear-gradient(var(--kept-grid) 1px, transparent 1px), linear-gradient(90deg, var(--kept-grid) 1px, transparent 1px); background-size: 24px 24px; }
      * { box-sizing: border-box; }
      body {
        margin: 0; color: var(--ink);
        background-color: var(--field); background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 24px 24px;
        font: 400 15px/1.45 "Instrument Sans", system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      }
      main { min-height: 100vh; padding: 4.2vh 5.2vw 4.6vh; overflow-wrap: anywhere; display: flex; flex-direction: column; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .caps { font: 500 0.69rem/1.35 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
      a:hover { text-decoration-thickness: 2px; }
      a:focus-visible, input:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

      .mast { display: flex; align-items: baseline; gap: 1.1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.7rem; margin: 0 0 3vh; max-width: 46vw; }
      .mast .name { font: italic 400 1.55rem/1 "Instrument Serif", serif; margin: 0; }
      .mast .sub { color: var(--soft); }
      /* the captions are read, not glanced at: 15px (14px on a phone), in --caption, 6.5:1 on the field */
      #how { margin: 1.3rem 0 0; font-size: 15px; line-height: 1.5; color: var(--caption); max-width: 52ch; }

      /* the sentence: the protagonist, set on its strip over the harbour */
      .sentence { font: 400 clamp(40px, 4.6vw, 86px)/1.04 "Instrument Serif", serif; letter-spacing: -0.012em; margin: 0 0 1.2rem; }
      .sentence.past { font-style: italic; color: #3b3630; }
      /* the last word and the full stop: no line break between them, while the word itself wraps as any other */
      .sentence .end { white-space: nowrap; }
      .sentence .end > .pos { white-space: normal; }
      .sentence .pos { position: relative; display: inline-flex; flex-direction: column; vertical-align: top; max-width: 100%; padding-bottom: 0.18em; }
      /* Each word's label and input share one grid cell, so editing happens in
         the word's own place. The input contributes no width (width: 0) and
         fills the cell (min-width: 100%), so the cell is exactly the word:
         nothing shifts when it's focused. */
      .sentence form { position: relative; display: inline-grid; max-width: 100%; }
      .sentence form > label, .sentence form > input[name="word"] { grid-area: 1 / 1; min-width: 0; }
      .sentence input[name="word"] {
        width: 0; min-width: 100%; margin: 0; padding: 0; border: 0; border-bottom: 1px solid var(--ink); border-radius: 0;
        /* a line and its rule, at rest as when focused: an input's own height is taller than the sentence's line, and
           the cell it shares with the word shrank when focus set this (spec/word-field.test.ts) */
        height: calc(1lh + 1px);
        /* the label's own face, so the field is exactly the word's width and focusing it moves nothing */
        font: inherit; letter-spacing: inherit; color: inherit; background: transparent; opacity: 0; cursor: text;
      }
      .sentence input[name="word"]::placeholder { color: var(--faint); opacity: 1; }
      .sentence form:focus-within label { visibility: hidden; }
      /* shown while in hand, with the page's keyboard focus outline (a:focus-visible, input:focus-visible) */
      .sentence form:focus-within input[name="word"] { opacity: 1; }
      /* the label carries the field's 1px rule, unseen, so the word and its field are the same size */
      .sentence label { border-bottom: 1px solid transparent; cursor: text; text-decoration-line: underline; text-decoration-thickness: 1px; text-decoration-color: transparent; text-underline-offset: 0.11em; transition: color 0.25s; }
      /* choosing a word: the others recede, the chosen one is drawn in ink */
      body.selecting .sentence .pos:not(.selected) label { color: var(--faint); }
      @media (hover: hover) {
        .sentence .pos:hover label:not(:has(mark)), .sentence .pos.pointed label:not(:has(mark)) { text-decoration-color: rgb(25 23 20 / 0.35); }
      }
      /* every word at rest shows it can be changed, by a faint solid line, on every device (your own word keeps its dotted
         one); pointing darkens it (above, more specific). A desktop showed nothing until hover, and at the 28 October
         playtest people there didn't see the words could be clicked */
      .sentence label:not(:has(mark)) { text-decoration-color: var(--hair); }
      /* your holding word: a thin line fills under it until the hold ends (settle mode, your page only); never red */
      .sentence .settling {
        position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; pointer-events: none;
        background: var(--soft); transform-origin: left; transform: scaleX(var(--from, 0));
        animation: settling var(--ms, 0ms) linear forwards;
      }
      @keyframes settling { to { transform: scaleX(1); } }
      /* your word, while it stands: a hairline of dots, no badge */
      mark { background: none; color: inherit; text-decoration: underline dotted 1.5px var(--soft); text-underline-offset: 0.14em; }
      /* Where supported, grow with what's typed rather than scroll within the word,
         sideways only: one line high, so focusing a word doesn't move the sentence. */
      @supports (field-sizing: content) {
        .sentence form:focus-within input[name="word"] { field-sizing: content; width: auto; max-width: 80vw; height: calc(1lh + 1px); /* a line and its rule, as unfocused */ }
        /* until something is typed it lies over its word, which keeps its own width: focus moves nothing */
        .sentence form:focus-within input[name="word"]:placeholder-shown { position: absolute; left: 0; top: 0; }
      }
      /* Without field-sizing the grid cell is all the field gets, and the rule above that
         should widen it (min-width: 100%) loses to the shared `min-width: 0` on specificity,
         so the focused field was 0px wide: focused, taking keystrokes, and invisible, with
         its word hidden. Here it lies over its word instead: the word's own box (the cell
         keeps its size, so nothing moves), wider when it needs to be, over what's beside it. */
      @supports not (field-sizing: content) {
        .sentence form:focus-within input[name="word"] { position: absolute; left: 0; top: 0; height: 100%; width: max(100%, 3.2em); max-width: 80vw; background: var(--field); z-index: 1; }
      }
      /* the word leaving as its body is rebuilt (decorative; the label is the word) */
      .sentence .leaving { position: absolute; left: 0; top: 0; white-space: nowrap; pointer-events: none; }
      /* Someone else changed this word while you were typing a draft for it.
         The note keeps one line of height in its word's column (so it never
         covers the row below) but no width, so the sentence never re-flows;
         the client keeps it inside the sentence's width. */
      .sentence .changed {
        font: italic 400 1rem/1.3 "Instrument Serif", serif; color: var(--soft); margin-top: 0.35rem; letter-spacing: 0;
        width: 0; min-width: 100%; white-space: nowrap;
      }
      .sentence .changed > span {
        display: inline-block; vertical-align: top; position: relative; z-index: 1;
        padding-right: 0.4em; background: var(--field); overflow: hidden; text-overflow: ellipsis;
      }

      /* The question first (spec/question-band.test.ts): a paper strip above the harbour, the masthead, the
         question and Theseus's ship on the left, how to play on the right; folded, the masthead and the question
         on one line. Read, not decorative: the question is the page's h2. */
      /* the band and the stage are the first screen, together: the stage takes what the band leaves */
      main:has(> .first) { padding: 0; }
      .first { display: flex; flex-direction: column; height: 100svh; min-height: 560px; }
      .first > .stage { flex: 1 1 auto; }
      #question { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: 4vw; align-items: end;
        padding: 2.2vh 3.6vw 2vh; border-bottom: 1px solid var(--rule); }
      #question .mast { max-width: none; margin: 0; border-bottom: 0; padding-bottom: 0; }
      #question .question-line { margin: 1.2vh 0 0; font: italic 400 clamp(26px, 2.3vw, 40px)/1.12 "Instrument Serif", serif; letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
      #question .ship { margin: 0.6rem 0 0; font-size: 14px; line-height: 1.5; color: var(--caption); max-width: 62ch; text-wrap: pretty; }
      #question .how h3 { margin: 0 0 0.5rem; color: var(--soft); }
      #question .how-to-play { margin: 0; padding: 0; list-style: none; counter-reset: step; display: flex; flex-direction: column; gap: 0.45rem; }
      #question .how-to-play li { counter-increment: step; display: flex; gap: 0.75rem; align-items: baseline; font-size: 14px; line-height: 1.4; color: var(--ink); }
      #question .how-to-play li::before { content: counter(step); flex: none; width: 22px; height: 22px; box-sizing: border-box; border: 1px solid rgb(25 23 20 / 0.55); border-radius: 50%;
        font: 500 10.5px/20px var(--mono); text-align: center; color: var(--ink); transform: translateY(-1px); }
      /* step 1: a touch screen taps, anything else clicks */
      #question .on-phone { display: none; }
      @media (pointer: coarse) { #question .on-phone { display: inline; } #question .on-desktop { display: none; } }
      /* the band's way to how the planks are made: with the question, so it stays once folded */
      #question .band-ship { margin-left: 1.2rem; color: var(--soft); white-space: nowrap; text-decoration-color: var(--hair); text-underline-offset: 0.2em; }
      /* folded: the masthead and the question on one line */
      #question.folded { display: flex; align-items: baseline; gap: 2vw; padding-bottom: 1.2vh; padding-top: 1.8vh; }
      #question.folded .question-main { display: flex; align-items: baseline; gap: 2vw; min-width: 0; }
      #question.folded .question-line { margin: 0; font-size: clamp(18px, 1.5vw, 24px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      /* ---- the harbour (docs/decisions/0005-the-ship.md) ----
         One stage: the harbour fills it, and the sentence strip lies over its foot, as the prototype's panel does.
         The stage takes what the first screen leaves under the band, so the sentence is always on it; the harbour's
         canvas lies over its host, which the stage sizes. Parchment and ink, as the prototype. */
      :root { --parchment: #f6eedd; --parchment-edge: #dccaa6; --brown: #2a2019; --brown-soft: #5e4f3f; --brown-faint: rgb(42 32 25 / 0.42); --brown-hair: rgb(42 32 25 / 0.2); }
      .stage { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 0; background: #e8d2ad; }
      .harbour { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
      .harbour canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
      /* without WebGL the harbour gives way: the strips are the page */
      .harbour.no-webgl { display: none; }
      .stage:has(> .harbour.no-webgl) { min-height: 0; background: none; }
      .strip { position: relative; z-index: 2; background: var(--parchment); color: var(--brown); border: 1px solid var(--parchment-edge); }
      .sentence-strip { margin: 0 auto 1.6vh; width: min(1180px, calc(100% - 2 * 3.6vw)); border-radius: 6px; box-shadow: 0 18px 50px rgb(40 25 10 / 0.28); padding: 1rem 1.6rem 0.8rem; }
      .strip-label { margin: 0; color: var(--brown-soft); }
      .head-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem; }
      .to-kept, .to-sentence { display: none; white-space: nowrap; color: var(--brown-soft); text-decoration-color: var(--brown-hair); }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      /* the live sentence: still the largest text on the page, stepping down through fixed sizes to stay on two lines (src/lib/sentence-step.ts) */
      .sentence-strip .sentence { --step: 1; font-size: calc(clamp(30px, 2.95vw, 56px) * var(--step)); color: var(--brown); margin: 0; line-height: 1.02; }
      .sentence-strip .sentence[data-step="1"] { --step: 0.92; }
      .sentence-strip .sentence[data-step="2"] { --step: 0.85; }
      .sentence-strip .sentence[data-step="3"] { --step: 0.8; }
      .sentence-strip .sentence input[name="word"]::placeholder { color: var(--brown-faint); }
      .sentence-strip .sentence label:not(:has(mark)) { text-decoration-color: var(--brown-hair); }
      body.selecting .sentence-strip .sentence .pos:not(.selected) label, body.pointing .sentence-strip .sentence .pos:not(.pointed) label { color: var(--brown-faint); }
      @media (hover: hover) {
        .sentence-strip .sentence .pos:hover label:not(:has(mark)), .sentence-strip .sentence .pos.pointed label:not(:has(mark)) { text-decoration-color: rgb(42 32 25 / 0.7); }
      }
      .sentence-strip .sentence .changed > span { background: var(--parchment); }
      @supports not (field-sizing: content) { .sentence-strip .sentence form:focus-within input[name="word"] { background: var(--parchment); } }
      .sentence-strip .sentence input:focus-visible { outline-color: var(--brown); }
      /* each word's place and part, "01·Ram", small above it: navigation, drawn, never read (spec/numbering.test.ts).
         Two rows of labels over every line: a label wider than its word rises to the upper row, so the words keep
         their ordinary spacing and no two labels meet (src/lib/sentence-step.ts labelRows, set by the server and the
         live client per layout; spec/harbour-layout.test.ts, spec/numbering.test.ts). Every line keeps both rows,
         so the words of a line stand level. */
      .sentence-strip .sentence { counter-reset: word; --tag-size: 8px; --tag-row: calc(var(--tag-size) + 3px); }
      .sentence-strip .sentence .pos { counter-increment: word; padding-top: calc(2 * var(--tag-row) + 2px); padding-bottom: 0.1em; vertical-align: baseline; }
      .sentence-strip .sentence .pos::before {
        content: counter(word, decimal-leading-zero) "·" attr(data-part) / ""; position: absolute; left: 1px; top: calc(var(--tag-row) + 1px);
        font: 500 var(--tag-size)/1 var(--mono); font-style: normal; letter-spacing: -0.03em; color: var(--brown-soft); white-space: nowrap; pointer-events: none;
      }
      .sentence-strip .sentence .pos[data-row-desktop="2"]::before { top: 1px; }
      /* a label that fits on neither row: its word takes just the room the label needs */
      .sentence-strip .sentence .pos[data-row-desktop="room"] { min-width: calc(var(--tag-ch) * var(--tag-size) * 0.57 + 4px); }
      /* the notation's slot under the sentence: at rest the invitation and the way to /ship/; a word in hand, the notation */
      .sentence-strip .slot { position: relative; margin-top: 0.35rem; min-height: 1.45em; }
      #part, .sentence-strip .invite-row { margin: 0; color: var(--brown-soft); }
      #part { position: absolute; inset: 0 0 auto 0; }
      #part[hidden] { display: block; visibility: hidden; }
      .sentence-strip .invite-row { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 1.6rem; row-gap: 0.3rem; }
      .sentence-strip .invite { margin: 0; color: var(--brown-soft); white-space: nowrap; }
      .sentence-strip .invite-ship { color: var(--brown-soft); white-space: nowrap; text-decoration-color: var(--brown-hair); text-underline-offset: 0.2em; }
      #part:not([hidden]) ~ .invite-row { visibility: hidden; }
      /* while a replacement is typed: one line, the replaced word struck, and only a word shortened when long; the prediction is never cut */
      #part:has(> del) { display: flex; white-space: pre; }
      #part > span { flex: none; }
      #part > del, #part > b { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
      #part > del { text-decoration-thickness: 1px; color: var(--brown); }
      #part > b { font-weight: inherit; min-width: 4.5ch; color: var(--brown); }
      #part:has(> b) > del { flex-shrink: 0; }
      .sentence-strip .sentence .settling { background: var(--brown-soft); }
      .sentence-strip mark { text-decoration-color: var(--brown-soft); }
      /* only when the strips stack: the kept strip is below, so say so */
      .kept-pointer { display: none; margin: 0.3rem 0 0; font: italic 400 1.05rem/1.3 "Instrument Serif", serif; color: var(--brown-soft); }
      .kept-pointer.ack { color: var(--brown); position: relative; z-index: 4; }

      /* the tags: each ship's part pointed at or chosen, "08 · Oars", on the canvas (a desktop; never at rest) */
      .part-tag { position: absolute; left: 0; top: 0; z-index: 3; margin: 0; pointer-events: none; white-space: nowrap;
        background: #fffaf0; color: var(--brown); border: 1px solid var(--brown); border-radius: 4px; padding: 5px 9px; box-shadow: 0 6px 16px rgb(30 20 10 / 0.25); }
      .part-tag[hidden] { display: none; }
      .part-tag[data-ship="kept"] { background: #23324a; color: #eef3f8; border-color: #eef3f8; }
      .part-tag.red { border-color: #c3331c; }
      /* the way back to the harbour's fixed view, once a drag has moved it (a desktop) */
      #home { position: absolute; top: 1.4vh; right: 3.6vw; z-index: 3; min-height: 34px; padding: 9px 13px; border-radius: 999px; cursor: pointer;
        border: 1px solid #fffaf0; background: rgb(42 32 25 / 0.55); color: #fffaf0; }
      #home[hidden] { display: none; }
      #home:focus-visible { outline: 2px solid #fffaf0; outline-offset: 3px; }

      /* the kept strip: the ship of old planks in words, a step below the live sentence, which stays primary */
      .kept-strip { margin: 0 auto; width: min(1180px, calc(100% - 2 * 3.6vw)); border-radius: 6px; margin-top: 2.4vh; padding: 1rem 1.6rem 1.1rem; display: flex; flex-direction: column; gap: 0.7rem; }
      .kept-sentence { font: italic 400 clamp(24px, 2.1vw, 38px)/1.18 "Instrument Serif", serif; letter-spacing: -0.01em; margin: 0; color: var(--brown); }
      .kept-sentence .end { white-space: nowrap; }
      .kept-sentence mark { text-decoration-color: var(--brown-soft); }
      /* a gap: the word still standing at its place, faint, over a dashed line (a second cue besides lightness: a kept word
         has no line, your own kept word a dotted one). Legible as text, clearly fainter than a kept word */
      .kept-sentence .gap { color: #7a6a57; text-decoration: underline dashed 1px #7a6a57; text-underline-offset: 0.14em; }
      .kept-note { margin: 0; font-size: 15px; line-height: 1.45; color: #4a3d30; text-wrap: pretty; }
      /* the last plank: one gap left, named, in the kept strip's own ink */
      .last-plank { margin: 0; font: italic 400 clamp(19px, 1.45vw, 24px)/1.25 "Instrument Serif", serif; color: var(--brown); text-wrap: pretty; }
      .last-plank[hidden] { display: none; }
      /* your plank's line in the notation's slot: the notation's own face */
      #part.yours { color: var(--brown); }
      .kept-sentence { counter-reset: kept; }
      .kept-sentence .w { position: relative; display: inline-block; padding-top: 12px; counter-increment: kept; }
      .kept-sentence .w::before { content: counter(kept, decimal-leading-zero) / ""; position: absolute; left: 1px; top: 0; font: 500 10px/1 var(--mono); font-style: normal; letter-spacing: 0.04em; color: var(--brown-soft); pointer-events: none; white-space: nowrap; text-decoration: none; }
      /* a gap stands as tall as a word over the baseline, so its number is level with the words' on its line */
      .kept-sentence .gap { box-sizing: content-box; height: calc(0.907em - 2px); }
      .kept-sentence .gap::before { left: 0; }
      /* the next ship's waiting words, each with its place small above it, drawn, never read */
      .waiting { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 1.1rem; row-gap: 0.2rem; border-top: 1px solid var(--parchment-edge); padding-top: 0.6rem; }
      .waiting[hidden] { display: none; }
      .waiting .label { color: var(--brown-soft); margin-right: 0.1rem; }
      .waiting .ws { display: contents; }
      .waiting .w { position: relative; display: inline-block; padding-top: 12px; font: italic 400 clamp(20px, 1.5vw, 24px)/1.2 "Instrument Serif", serif; color: var(--brown); overflow-wrap: anywhere; min-width: 0; }
      .waiting .w::before { content: attr(data-n) / ""; position: absolute; left: 1px; top: 0; font: 500 10px/1 var(--mono); font-style: normal; letter-spacing: 0.04em; color: var(--brown-soft); }
      .kept-strip .earlier { margin: 0; color: var(--brown-soft); }

      /* the notes, under the kept strip: the rule, your trace, Earlier form, the captions, the site's links last */
      .notes { margin: 0 auto; width: min(1180px, calc(100% - 2 * 3.6vw)); padding: 1.6rem 0 2.4rem; display: flex; flex-direction: column; gap: 0.9rem; }
      .foot-main, .foot-aside { display: flex; flex-direction: column; gap: 0.9rem; min-width: 0; }
      .notes #how { margin: 0; }
      .notes section[aria-labelledby="trace-heading"] { margin-top: 0; }
      .notes .earlier { margin: 0; }
      .plate-note { font: italic 400 clamp(20px, 1.7vw, 28px)/1.22 "Instrument Serif", serif; color: var(--ink); margin: 0; letter-spacing: -0.005em; text-wrap: balance; }
      .kept-strip .plate-note { color: var(--brown); font-size: clamp(19px, 1.45vw, 24px); }
      .plate-note .line { display: block; text-wrap: balance; }
      .question { font: italic 400 clamp(15px, 1.15vw, 19px)/1.35 "Instrument Serif", serif; color: var(--soft); margin: 0; max-width: 34ch; }
      #how, section[aria-labelledby="trace-heading"] [role="status"], .question { text-wrap: pretty; }
      .notes .about { margin: 0; }
      .about a { white-space: nowrap; }
      @media (min-width: 901px) {
        /* a title block: the rule, your trace and Earlier on the left, the captions on the right, the links across */
        .notes { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); column-gap: 3vw; row-gap: 0; align-items: start; border-top: 1px solid var(--rule); margin-top: 2.4vh; }
        .notes .foot-main { grid-column: 1; }
        .notes .foot-aside { grid-column: 2; border-left: 1px solid var(--rule); padding-left: 1.6vw; }
        .notes .question { border-top: 1px solid var(--rule); padding-top: 0.8rem; }
        .notes .about { grid-column: 1 / -1; padding-top: 0.8rem; border-top: 1px solid var(--rule); margin-top: 1.4rem; }
      }

      /* an earlier form and an earlier ship: the ship alone, the sentence on its strip over the scene's foot */
      main:has(> .harbour) { position: relative; min-height: 100svh; padding: 0; display: flex; flex-direction: column; }
      main:has(> .harbour) > .mast { position: relative; z-index: 2; margin: 0; padding: 1.4rem 3.6vw 0.7rem; max-width: none; background: var(--field); }
      main:has(> .harbour) > .harbour { position: relative; flex: 1; min-height: 46vh; }
      .earlier-strip { margin: -12vh auto 0; width: min(1180px, calc(100% - 2 * 3.6vw)); border-radius: 6px; padding: 1rem 1.6rem 0.9rem; box-shadow: 0 18px 50px rgb(40 25 10 / 0.28); }
      .earlier-strip .sentence { font-size: clamp(30px, 2.95vw, 56px); color: var(--brown); margin: 0.2rem 0 0; }
      .earlier-strip .form-state, .earlier-strip .history { color: var(--brown-soft); }
      main:has(> .harbour) > .about { position: relative; z-index: 2; margin: 1.2rem auto 1.6rem; width: min(1180px, calc(100% - 2 * 3.6vw)); }
      .lone-ship { position: relative; display: flex; flex-direction: column; min-height: 100svh; }
      .lone-ship > .mast { position: relative; z-index: 2; margin: 0; padding: 1.4rem 3.6vw 0.7rem; max-width: none; }
      .lone-ship > .harbour { position: relative; flex: 1; min-height: 46vh; }
      .kept-strip-lone { margin: -10vh auto 0; width: min(1180px, calc(100% - 2 * 3.6vw)); border-radius: 6px; padding: 1rem 1.6rem 0.9rem; box-shadow: 0 18px 50px rgb(40 25 10 / 0.28); }
      .kept-strip-lone .strip-label, .kept-strip-lone .history { color: var(--brown-soft); }
      .lone-ship > .about { margin: 1.2rem auto 1.6rem; width: min(1180px, calc(100% - 2 * 3.6vw)); }
      .history { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin: 0.9rem 0 0; }
      .history a, .earlier a, .about a { text-decoration-color: var(--hair); }
      .strip .history a, .strip .earlier a { text-decoration-color: var(--brown-hair); }
      .earlier, .about { margin: 1.2rem 0 0; color: var(--soft); }
      .form-state { color: var(--soft); margin: 0 0 0.4rem; }
      /* your trace: a quiet footnote to the shared sentence, not a panel */
      section[aria-labelledby="trace-heading"] { padding-top: 0.8rem; border-top: 1px solid var(--hair); max-width: 52ch; }
      #trace-heading { margin: 0 0 0.3rem; font-size: 0.66rem; font-weight: 400; letter-spacing: 0.18em; text-transform: uppercase; color: var(--soft); }
      section[aria-labelledby="trace-heading"] [role="status"] { margin: 0; font-size: 15px; line-height: 1.5; color: var(--caption); }
      section[aria-labelledby="trace-heading"] del { font: italic 400 1.1rem/1 "Instrument Serif", serif; color: var(--ink); text-decoration-thickness: 1px; }
      section[aria-labelledby="trace-heading"] ul { list-style: none; margin: 0.6rem 0 0; padding: 0; font-size: 0.85rem; color: var(--soft); }
      section[aria-labelledby="trace-heading"] ul + ul { margin-top: 0.3rem; }
      section[aria-labelledby="trace-heading"] li { margin: 0.25rem 0; }
      [role="alert"] { font: 400 1.6rem/1.25 "Instrument Serif", serif; max-width: 30ch; }

      /* Ship 1 complete (docs/decisions/0003): the one loud line, live, once. Not red (red is only a part being
         rebuilt): pale, in difference. src/lib/moment-line.ts sets its top in the clear band of the screen; the
         harbour and both strips are veiled behind it. */
      .moment {
        position: fixed; left: 0; right: 0; top: 38%; z-index: 5; margin: 0; padding: 0 6vw; text-align: center; pointer-events: none;
        font: italic 400 clamp(34px, 5.4vw, 104px)/1.02 "Instrument Serif", serif; letter-spacing: -0.015em; text-wrap: balance;
        color: #fff; mix-blend-mode: difference; opacity: 0; transition: opacity 0.7s;
      }
      .moment.on { opacity: 1; }
      .harbour::after, .strip::after { content: ""; position: absolute; inset: 0; z-index: 4; background: #e8d2ad; opacity: 0; pointer-events: none; transition: opacity 0.6s; border-radius: inherit; }
      .strip::after { background: var(--parchment); }
      body.moment-on .harbour::after, body.moment-on .strip::after { opacity: 0.86; }

      @media (max-width: 900px) {
        /* a struck word takes no more than what the rest of the stale line leaves */
        #part:has(> b) > del { max-width: calc(100% - 39.5ch); }
        main { padding: 1.1rem 1rem 1.4rem; }
        .mast { max-width: none; flex-wrap: wrap; gap: 0.2rem 0.9rem; margin-bottom: 1.1rem; }
        /* the question first, stacked: the masthead, the question, Theseus's ship, then how to play */
        #question { display: block; padding: 0.8rem 1rem 0.9rem; }
        #question .mast { margin: 0; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); flex-wrap: nowrap; }
        #question .mast .sub { display: none; }
        #question .band-ship { margin-left: auto; }
        #question .question-line { margin-top: 0.6rem; font-size: 23px; line-height: 1.1; }
        #question .ship { margin-top: 0.4rem; font-size: 13px; line-height: 1.4; }
        #question .how { margin-top: 0.6rem; }
        #question .how h3 { margin-bottom: 0.35rem; }
        #question .how-to-play { gap: 0.25rem; }
        #question .how-to-play li { font-size: 13px; line-height: 1.36; gap: 0.6rem; }
        #question .how-to-play li::before { width: 19px; height: 19px; font-size: 9.5px; line-height: 17px; }
        #question.folded, #question.folded .question-main { display: block; }
        #question.folded .question-line { margin-top: 0.6rem; font-size: 20px; white-space: normal; }
        /* stacked: the sentence strip first, then the harbour under it, then the kept strip and the notes */
        .first { height: auto; min-height: 0; }
        .stage { min-height: 0; flex-direction: column; background: none; }
        .harbour { position: relative; order: 2; height: min(90vw, 360px); margin: 0; }
        .sentence-strip { order: 1; width: auto; margin: 0; border-radius: 0; border-width: 0 0 1px; box-shadow: none; padding: 0.7rem 1rem 0.6rem; }
        .sentence-strip .head-row { margin-bottom: 0.2rem; }
        .sentence-strip .strip-label { display: none; }
        .to-kept, .to-sentence { display: inline; }
        .kept-pointer { display: block; }
        .sentence-strip .head-row { justify-content: flex-end; }
        .sentence-strip .sentence { font-size: 30px; line-height: 1.04; }
        /* a phone's line is taller than its word (the 44px tap target): the upper row of labels sits in the room
           above the word that target already gives, so it adds no height */
        .sentence-strip .sentence { --tag-size: 7.5px; --tag-row: calc(var(--tag-size) + 2.5px); }
        .sentence-strip .sentence .pos { padding-top: calc(var(--tag-row) + 2px); }
        .sentence-strip .sentence .pos::before, .sentence-strip .sentence .pos[data-row-desktop="2"]::before { top: 1px; }
        .sentence-strip .sentence .pos[data-row-phone="2"]::before { top: calc(1px - var(--tag-row)); }
        .sentence-strip .sentence .pos[data-row-desktop="room"] { min-width: 0; }
        .sentence-strip .sentence .pos[data-row-phone="room"] { min-width: calc(var(--tag-ch) * var(--tag-size) * 0.57 + 4px); }
        .sentence-strip .invite-ship { display: none; }
        .part-tag { display: none !important; }
        #home { display: none !important; }
        .kept-strip { width: auto; margin: 0; border-radius: 0; border-width: 1px 0; padding: 1rem 1rem 1.2rem; }
        .kept-sentence { font-size: 25px; line-height: 1.3; }
        .kept-sentence .gap { height: calc(0.96em - 2px); }
        .notes { width: auto; padding: 1.2rem 1rem 2rem; }
        .foot-main, .foot-aside { display: contents; }
        .notes .about { order: 1; }
        #how, section[aria-labelledby="trace-heading"] [role="status"], .kept-note { font-size: 14px; }
        /* no Escape key on a phone: the instructions' Escape sentence is read, not shown */
        #how .esc { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        .sentence input[name="word"]:focus-visible { outline-offset: 1px; }
        /* a word's target is as tall as its form (44px) and a little wider than the word, no further */
        .sentence label { position: relative; }
        .sentence label::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: calc(100% + 0.16em); transform: translateX(-50%); }
        .sentence form { min-height: 44px; }
        main:has(> .harbour) > .harbour, .lone-ship > .harbour { flex: none; height: min(62vw, 300px); min-height: 0; }
        .earlier-strip, .kept-strip-lone { margin: 0; width: auto; border-radius: 0; box-shadow: none; }
        main:has(> .harbour) > .mast, .lone-ship > .mast { padding: 1rem 1rem 0.6rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .sentence label { transition: none; }
        .moment, .harbour::after, .strip::after { transition: none; }
      }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>

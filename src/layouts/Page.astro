---
// The one page shell: language, viewport, title and the minimal styles every
// view shares. Visitor words are only ever interpolated as text.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      body { margin: 0; font-family: Georgia, "Iowan Old Style", serif; line-height: 1.5; }
      main { max-width: 46rem; margin: 0 auto; padding: 2rem 1rem; overflow-wrap: anywhere; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .sentence { font-size: clamp(1.75rem, 6vw, 3rem); line-height: 1.2; margin: 1.5rem 0; }
      .sentence .pos { display: inline-flex; flex-direction: column; vertical-align: top; max-width: 100%; padding-bottom: 0.3em; }
      /* Each word's label and input share one grid cell, so editing happens in
         the word's own place. The input contributes no width (width: 0) and
         fills the cell (min-width: 100%), so the cell is exactly the word:
         nothing shifts when it's focused. */
      .sentence form { display: inline-grid; max-width: 100%; }
      .sentence form > label, .sentence form > input[name="word"] { grid-area: 1 / 1; min-width: 0; }
      .sentence input[name="word"] {
        width: 0; min-width: 100%; margin: 0; padding: 0; border: 0; border-bottom: 2px solid transparent;
        font: inherit; color: inherit; background: transparent; opacity: 0; cursor: text;
      }
      .sentence input[name="word"]::placeholder { color: inherit; opacity: 0.6; }
      .sentence form:focus-within label { visibility: hidden; }
      .sentence form:focus-within input[name="word"] { opacity: 1; outline: 3px solid; outline-offset: 3px; }
      .sentence label { cursor: text; }
      /* a quiet cue that a word can be replaced: live page, pointer devices,
         and never on your own standing word, which keeps its solid underline */
      @media (hover: hover) {
        .sentence form:hover label:not(:has(mark)) {
          text-decoration: underline dotted 1px; text-underline-offset: 0.15em; text-decoration-color: #8a8a8a;
        }
      }
      /* Where supported, grow with what's typed rather than scroll within the word. */
      @supports (field-sizing: content) {
        .sentence form:focus-within input[name="word"] { field-sizing: content; width: auto; max-width: 80vw; }
      }
      /* The words a position held before sit beneath it but take no part in
         its width (width: 0, then min-width: 100% of the word), so the
         sentence spaces and wraps by its current words alone; a long one is
         cut short rather than pushing its neighbours apart. */
      .sentence .past {
        font-size: 0.9rem; opacity: 0.6; display: flex; flex-direction: column;
        width: 0; min-width: 100%; margin-top: 0.5rem; /* clears the focus outline */
      }
      .sentence .past > span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; overflow-wrap: normal; }
      /* Someone else changed this word while you were typing a draft for it.
         The notice keeps one line of height in its word's column (so it never
         covers the row below) but no width, so the sentence never re-flows;
         its line runs on over neighbouring faded past words, on the page's
         own colour. The client keeps it inside the sentence's width. */
      .sentence .changed {
        font-size: 0.9rem; font-style: italic; margin-top: 0.5rem; /* clears the focus outline */
        width: 0; min-width: 100%; white-space: nowrap;
      }
      .sentence .changed > span {
        display: inline-block; vertical-align: top; position: relative; z-index: 1;
        padding-right: 0.4em; background: Canvas; overflow: hidden; text-overflow: ellipsis;
      }
      mark { background: none; text-decoration: underline 0.08em; text-underline-offset: 0.15em; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
      a:hover { text-decoration-thickness: 2px; }
      a:focus-visible, input:focus-visible { outline: 3px solid; outline-offset: 2px; }
      .history { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 1.5rem 0; }
      /* your trace: a quiet footnote to the shared sentence, not a panel */
      section[aria-labelledby="trace-heading"] { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid #ddd; }
      #trace-heading {
        margin: 0 0 0.5rem; font-size: 0.8rem; font-weight: normal; letter-spacing: 0.08em; text-transform: uppercase;
        color: #595959;
      }
      section[aria-labelledby="trace-heading"] [role="status"] { margin: 0; }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
